PORT=3004

# This is a CLIENT, not a service behind the gateway - every feature it
# offers is implemented by calling the API Gateway, never a backend
# service directly. See docs/DESIGN.md.
GATEWAY_URL=http://localhost:8080

# Signs the cookie that holds the caller's JWT, so a casual edit in the
# browser's devtools is rejected outright instead of silently being
# trusted for nav/role display (the real authorization check always
# happens downstream at the gateway/services, which verify the JWT itself
# - this only protects this server's own convenience decoding, see
# src/services/jwt.js).
COOKIE_SECRET=change-this-to-a-long-random-string

# Set to "production" to mark the session cookie Secure (HTTPS only).
NODE_ENV=development
