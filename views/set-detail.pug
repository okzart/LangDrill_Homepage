//- An item's English sentence with its blanked words highlighted. Blank
//- positions count [A-Za-z']+ tokens, the same way the apps count them.
mixin marked(answer, blanks)
  - var blankAt = {}
  - (Array.isArray(blanks) ? blanks : []).forEach(function (b) { if (b) blankAt[b.at] = true; })
  - var parts = [], at = 0, last = 0, m, re = /[A-Za-z']+/g, text = String(answer || '')
  - while ((m = re.exec(text)) !== null) { parts.push({ t: text.slice(last, m.index) }); parts.push({ t: m[0], blank: !!blankAt[at] }); last = m.index + m[0].length; at++; }
  - parts.push({ t: text.slice(last) })
  p.answer
    each part in parts
      if part.blank
        mark= part.t
      else
        | #{part.t}

doctype html
html(lang=lang || "en")
  head
    meta(charset="UTF-8")
    title LanguageDrill — #{set.name}
    include _style
    style.
      .hint { font-size: 0.8rem; color: #666; }
      .actions-bar { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; background: #fff; padding: 0.5rem 0; margin-bottom: 1rem; border-bottom: 1px solid #ddd; }
      .actions-bar .spacer { flex: 1; }
      .actions-bar button, .actions-bar .btn { margin-top: 0; }
      .actions-bar .btn { border: 1px solid #767676; border-radius: 2px; background: #efefef; color: #222; text-decoration: none; font-size: 0.85rem; }
      .play-all { margin-bottom: 1rem; }
      .play-all .row button { margin-top: 0; }
      .play-all-options { margin-top: 0.5rem; font-size: 0.85rem; }
      .play-all-options label { display: inline-flex; align-items: center; gap: 0.3rem; margin: 0; }
      .play-all-options select { width: auto; margin: 0; }
      .play-all-options input[type="checkbox"] { width: auto; margin: 0; }
      /* Compact item rows: text on the left, a slim player on the right. */
      #items ol { margin: 0.5rem 0; padding-left: 2.2rem; }
      #items ol > li { padding: 0.3rem 0.5rem; border-bottom: 1px solid #eee; font-size: 0.92rem; transition: background 0.2s; }
      #items ol > li::marker { color: #888; font-size: 0.8rem; }
      #items .item { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; }
      #items .item-text { flex: 1 1 16rem; min-width: 0; line-height: 1.35; }
      #items .item-text p { margin: 0; }
      #items .item-text .ko, #items .item-text .hint, #items .item-text .field { font-size: 0.82rem; }
      #items .item-text .ko { color: #555; }
      #items .item > audio { flex: none; width: 15rem; max-width: 100%; height: 30px; }
      #items .item > .hint { font-size: 0.78rem; }
      #items .kind { float: right; margin-left: 0.5rem; padding: 0 0.45rem; border: 1px solid #ddd; border-radius: 999px; font-size: 0.72rem; color: #666; }
      #vocabItems li.now-playing { background: #eef4ff; }
      .pager { justify-content: center; margin-top: 1rem; font-size: 0.9rem; }
      .pager span { color: #666; }
      .pager { flex-wrap: wrap; }
      .pager .per-page { display: inline-flex; align-items: center; gap: 0.4rem; margin: 0 0 0 0.75rem; }
      .pager .per-page label { margin: 0; }
      .pager .per-page select { width: auto; margin: 0; min-height: 0; padding-top: 3px; padding-bottom: 3px; }
      ul.options { margin: 0.1rem 0; padding-left: 1.1rem; font-size: 0.82rem; color: #555; }
      ul.options li.correct { color: #1d1f20; font-weight: 600; }
  body
    include _nav
    h1= set.name

    //- Page actions, pinned to the top of the viewport while scrolling so
    //- they stay reachable on long sets (they used to sit below the full
    //- item list and JSON dump).
    .actions-bar
      a(href="/community")= t('← Back to Community')
      span.spacer
      form.inline(method="POST" action=`/community/${set.id}/download`)
        button(type="submit")= t('Download (+1)')
      a.btn(href=`/community?tab=list&editId=${set.id}`)= t('Modify')
      form.inline(method="POST" action=`/community/${set.id}/delete` onsubmit=`return confirm(${JSON.stringify(t('Unpublish this set? This cannot be undone.'))})`)
        button.danger(type="submit")= t('Unpublish')

    if error
      .error= t(error)
    if published
      .success= t('Published.')
    if downloaded
      .success= t('Downloaded — download count bumped below.')

    section
      table
        tr
          th= t('Type')
          td= t(set.type)
        tr
          th= t('Author')
          td= set.author
        if set.type === 'vocab'
          tr
            th= t('Audio voice')
            td= set.voice || t('default')
        tr
          th= t('Downloads')
          td= set.downloads
        tr
          th= t('Items')
          td= set.count
      p= set.desc

    //- One page of the set's items (see communityRoutes.js#itemPaging), each
    //- shown by its fields - never as raw JSON.
    section#items
      h2= t('Items')
      if set.type === 'vocab'
        - var audioCount = paging.items.filter(function (it) { return it && it.audioUrl; }).length
        //- "Play all": plays the audio of every item on this page in order
        //- (see the script at the bottom). Only rendered when at least one
        //- of them has audio.
        if audioCount > 0
          #playAll.play-all
            .row
              button#playAllBtn(type="button")= paging.totalPages > 1 ? t('▶ Play this page ({n})', { n: audioCount }) : t('▶ Play all ({n})', { n: audioCount })
              button#pauseAllBtn(type="button" hidden)= t('❚❚ Pause')
              button#stopAllBtn(type="button" hidden)= t('■ Stop')
            .row.play-all-options
              label(for="playAllGap")= t('Pause between items')
              select#playAllGap
                option(value="0")= t('none')
                option(value="1000") 1 s
                option(value="2000" selected) 2 s
                option(value="3000") 3 s
                option(value="5000") 5 s
              label
                input#playAllRepeat(type="checkbox")
                = ' ' + t('Repeat')
            p#playAllStatus.hint(aria-live="polite")
        ol#vocabItems(start=paging.first + 1)
          each item in paging.items
            li
              .item
                .item-text
                  p.ko= item.ko
                  +marked(item.answer, item.blanks)
                  - var extras = []
                  - if (item.keyKo) extras.push(t('Key word: {word}', { word: item.keyKo }))
                  - if (item.source) extras.push(t('Source: {source}', { source: item.source }))
                  if extras.length
                    p.hint= extras.join(' · ')
                if item.audioUrl
                  audio.item-audio(controls preload="none" src=`/community/audio/${item.audioUrl.replace('/audio/', '')}`)
                else
                  span.hint= t('(no audio yet)')
      else if set.type === 'listening'
        //- Listening items may carry their own clip (e.g. made on /studio);
        //- blanked words are highlighted.
        ol#listeningItems(start=paging.first + 1)
          each item in paging.items
            li
              .item
                .item-text
                  span.kind= t(item.type)
                  +marked(item.answer, item.blanks)
                  if item.ko
                    p.ko= item.ko
                  if Array.isArray(item.options) && item.options.length
                    ul.options
                      each option in item.options
                        li(class=(option === item.answer ? 'correct' : undefined))= option
                if item.audioUrl
                  audio.item-audio(controls preload="none" src=`/community/audio/${item.audioUrl.replace('/audio/', '')}`)
      else
        ol#writingItems(start=paging.first + 1)
          each item in paging.items
            li
              .item
                .item-text
                  span.kind= t(item.type)
                  if item.ko
                    p.ko= item.ko
                  if item.prompt
                    p.field
                      span.hint= t('Sentence to fix') + ': '
                      = item.prompt
                  if item.model
                    p.field
                      span.hint= t('Model answer') + ': '
                      = item.model
                  if Array.isArray(item.keyVocab) && item.keyVocab.length
                    p.field
                      span.hint= t('Must-use words') + ': '
                      = item.keyVocab.join(', ')
                  if item.tip
                    p.field
                      span.hint= t('Tip') + ': '
                      = item.tip
      //- Shown whenever the set is longer than the smallest page size, so
      //- the "per page" picker stays reachable after choosing a big one.
      if paging.total > paging.sizes[0]
        .row.pager
          if paging.page > 1
            a(href=`/community/${set.id}?${paging.query}page=${paging.page - 1}#items`)= t('← Prev')
          span= t('Page {page} of {pages} ({total} items total)', { page: paging.page, pages: paging.totalPages, total: paging.total })
          if paging.page < paging.totalPages
            a(href=`/community/${set.id}?${paging.query}page=${paging.page + 1}#items`)= t('Next →')
          //- Changing the size goes back to page 1 (no `page` field).
          form.per-page(method="GET" action=`/community/${set.id}#items`)
            label(for="perPage")= t('Per page')
            select#perPage(name="limit" onchange="this.form.submit()")
              each size in paging.sizes
                option(value=size selected=(size === paging.limit))= size
            noscript
              button(type="submit")= t('Show')

    //- Play-all controller. Reuses each item's own <audio> element (so the
    //- browser cache and the per-item controls stay in sync) and walks them
    //- in order, skipping items that have no audio. Playing an item by hand
    //- while play-all is running stops play-all, so two clips never overlap.
    if set.type === 'vocab'
      script.
        (function () {
          var playBtn = document.getElementById('playAllBtn');
          if (!playBtn) return; // no item has audio
          var pauseBtn = document.getElementById('pauseAllBtn');
          var stopBtn = document.getElementById('stopAllBtn');
          var gapSelect = document.getElementById('playAllGap');
          var repeatBox = document.getElementById('playAllRepeat');
          var statusEl = document.getElementById('playAllStatus');
          var audios = Array.prototype.slice.call(document.querySelectorAll('#vocabItems audio.item-audio'));

          var index = -1;      // position in `audios` currently playing, -1 = idle
          var paused = false;
          var gapTimer = null;
          var driving = false; // true while play-all itself is starting a clip

          function setStatus(text) { statusEl.textContent = text; }

          function highlight(audio) {
            audios.forEach(function (a) { a.closest('li').classList.remove('now-playing'); });
            if (audio) {
              var li = audio.closest('li');
              li.classList.add('now-playing');
              li.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
          }

          function updateButtons() {
            var running = index !== -1;
            playBtn.hidden = running;
            pauseBtn.hidden = !running;
            stopBtn.hidden = !running;
            pauseBtn.textContent = paused ? t('▶ Resume') : t('❚❚ Pause');
          }

          function playAt(i) {
            clearTimeout(gapTimer);
            if (i >= audios.length) {
              if (repeatBox.checked) { i = 0; } else { stop(t('Finished.')); return; }
            }
            index = i;
            paused = false;
            var audio = audios[i];
            highlight(audio);
            setStatus(t('Playing {n} of {total}', { n: i + 1, total: audios.length }));
            updateButtons();
            audio.currentTime = 0;
            driving = true;
            var p = audio.play();
            driving = false;
            if (p && p.catch) {
              // A clip that fails to load shouldn't end the whole run.
              p.catch(function () { if (index === i && !paused) next(); });
            }
          }

          function next() {
            var gap = parseInt(gapSelect.value, 10) || 0;
            var nextIndex = index + 1;
            if (gap > 0 && (nextIndex < audios.length || repeatBox.checked)) {
              setStatus(t('Next in {s} s…', { s: gap / 1000 }));
              gapTimer = setTimeout(function () { playAt(nextIndex); }, gap);
            } else {
              playAt(nextIndex);
            }
          }

          function stop(message) {
            clearTimeout(gapTimer);
            if (index !== -1) {
              audios[index].pause();
              audios[index].currentTime = 0;
            }
            index = -1;
            paused = false;
            highlight(null);
            updateButtons();
            setStatus(message || '');
          }

          audios.forEach(function (audio, i) {
            audio.addEventListener('ended', function () {
              if (index === i && !paused) next();
            });
            audio.addEventListener('error', function () {
              if (index === i && !paused) next();
            });
            // The user pressed play on a single item: hand control back to them.
            audio.addEventListener('play', function () {
              if (index !== -1 && !driving && index !== i) stop();
              audios.forEach(function (other) { if (other !== audio) other.pause(); });
            });
          });

          playBtn.addEventListener('click', function () { playAt(0); });
          stopBtn.addEventListener('click', function () { stop(); });
          pauseBtn.addEventListener('click', function () {
            if (index === -1) return;
            if (paused) {
              paused = false;
              updateButtons();
              var audio = audios[index];
              if (audio.ended || audio.currentTime === 0) { playAt(index); return; }
              setStatus(t('Playing {n} of {total}', { n: index + 1, total: audios.length }));
              driving = true;
              audio.play();
              driving = false;
            } else {
              paused = true;
              clearTimeout(gapTimer);
              audios[index].pause();
              updateButtons();
              setStatus(t('Paused at {n} of {total}', { n: index + 1, total: audios.length }));
            }
          });
        })();
