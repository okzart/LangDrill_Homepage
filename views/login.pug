doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title LanguageDrill — Log in
    include _style
  body
    include _nav
    h1 Log in

    if error
      .error= error

    section
      form(method="POST" action="/login")
        input(type="hidden" name="next" value=next)
        label(for="email") Email
        input#email(type="email" name="email" required value=email autofocus)
        label(for="password") Password
        input#password(type="password" name="password" required)
        button(type="submit") Log in
    p
      | No account yet?
      a(href="/register")  Register
