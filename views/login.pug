doctype html
html(lang=lang || "en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= 'LanguageDrill — ' + t('Log in')
    include _style
  body
    include _nav
    include mixins/authShell
    +authShell(t('Welcome back'), t('Log in to pick up where you left off.'))
      if error
        .error= t(error)
      form(method="POST" action="/login")
        input(type="hidden" name="next" value=next)
        .field
          label(for="email")= t('Email')
          input#email(type="email" name="email" required value=email autofocus autocomplete="email" placeholder="you@example.com")
          +icon('mail', 17)
        .field
          label(for="password")= t('Password')
          input#password(type="password" name="password" required autocomplete="current-password" placeholder="••••••••")
          +icon('lock', 17)
        button(type="submit")= t('Log in')
      p.alt
        = t('New to LanguageDrill?') + ' '
        a(href="/register")= t('Create an account')
