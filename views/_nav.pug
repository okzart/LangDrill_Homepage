//- Shared top bar, social-network style (styles in _style.pug): logo +
//- search on the left, icon tabs in the middle (the current page gets an
//- underline; on phones they become a bottom tab bar), round buttons on the
//- right. `currentUser`, `currentPath`, `lang`, `langReturn` and `t` come
//- from res.locals (src/middleware/currentUser.js, src/i18n/index.js).
include mixins/icons
- var here = currentPath || ''
- var isActive = function (prefix) { return here === prefix || here.indexOf(prefix + '/') === 0; }
//- EN | 한국어 segmented switch; the current language is highlighted.
mixin langSwitch
  - var back = encodeURIComponent(langReturn || '/dashboard')
  .seg(role="group" aria-label="Language / 언어")
    a(href=`/lang/en?next=${back}` hreflang="en" lang="en" class=lang !== 'ko' ? 'on' : '' aria-current=(lang !== 'ko' ? 'true' : false)) EN
    a(href=`/lang/ko?next=${back}` hreflang="ko" lang="ko" class=lang === 'ko' ? 'on' : '' aria-current=(lang === 'ko' ? 'true' : false)) 한국어
mixin tab(href, icon, label, active)
  a.tab(href=href class=active ? 'active' : '' title=label aria-label=label aria-current=(active ? 'page' : false))
    +icon(icon, 22)
    span.tab-label= label
nav.site(aria-label=t('Main'))
  .nav-left
    a.brand(href="/dashboard" aria-label="LanguageDrill")
      +brandMark(30)
      span.wordmark Language#[em Drill]
    if currentUser
      form.nav-search(method="GET" action="/community" role="search")
        input(type="hidden" name="tab" value="list")
        input(type="search" name="q" placeholder=t('Search sets') aria-label=t('Search sets'))
        +icon('search', 17)
  if currentUser
    .links
      +tab('/dashboard', 'home', t('Home'), isActive('/dashboard') || here === '/')
      +tab('/community', 'users', t('Community'), isActive('/community'))
      +tab('/studio', 'studio', t('Studio'), isActive('/studio'))
      +tab('/scan', 'scan', t('Scan'), isActive('/scan'))
      +tab('/chat', 'chat', t('Chat'), isActive('/chat'))
      +tab('/passages', 'book', t('Passages'), isActive('/passages'))
      +tab('/progress', 'chart', t('Progress'), isActive('/progress'))
    .me
      +langSwitch
      if currentUser.role === 'admin'
        details.admin-menu
          summary(class=isActive('/admin') ? 'active' : '' title=t('Admin'))
            +icon('shield', 17)
            span= t('Admin')
            +icon('chevron', 14)
          .menu
            a(href="/admin/users" class=isActive('/admin/users') ? 'active' : '')
              +icon('users', 18)
              = t('Users & progress')
            a(href="/admin/audio" class=isActive('/admin/audio') ? 'active' : '')
              +icon('volume', 18)
              = t('Vocab audio')
            a(href="/admin/listening" class=isActive('/admin/listening') ? 'active' : '')
              +icon('headphones', 18)
              = t('Listening (Dia2)')
      a.avatar(href="/profile" title=t('Profile - {email}', { email: currentUser.email }) aria-label=t('Profile - {email}', { email: currentUser.email }))= (currentUser.email || '?').charAt(0)
      form.inline(method="POST" action="/logout")
        button.link(type="submit" title=t('Log out') aria-label=t('Log out'))
          +icon('logout', 18)
  else
    span
    .me
      +langSwitch
      a.logout(href="/login")= t('Log in')
      a.cta(href="/register")= t('Get started')
//- Close the admin menu on an outside click or Escape.
script.
  (function () {
    var menu = document.querySelector('nav.site details.admin-menu');
    if (!menu) return;
    document.addEventListener('click', function (e) { if (menu.open && !menu.contains(e.target)) menu.open = false; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') menu.open = false; });
  })();
