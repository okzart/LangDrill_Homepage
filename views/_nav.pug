//- Shared top bar, social-network style (styles in _style.pug): logo +
//- search on the left, icon tabs in the middle (the current page gets an
//- underline; on phones they become a bottom tab bar), round buttons on the
//- right. `currentUser`, `currentPath`, `lang`, `langReturn` and `t` come
//- from res.locals (src/middleware/currentUser.js, src/i18n/index.js).
include mixins/icons
- var here = currentPath || ''
- var isActive = function (prefix) { return here === prefix || here.indexOf(prefix + '/') === 0; }
//- EN | 한국어 segmented switch; the current language is highlighted.
mixin langSwitch
  - var back = encodeURIComponent(langReturn || '/dashboard')
  .seg(role="group" aria-label="Language / 언어")
    a(href=`/lang/en?next=${back}` hreflang="en" lang="en" class=lang !== 'ko' ? 'on' : '' aria-current=(lang !== 'ko' ? 'true' : false)) EN
    a(href=`/lang/ko?next=${back}` hreflang="ko" lang="ko" class=lang === 'ko' ? 'on' : '' aria-current=(lang === 'ko' ? 'true' : false)) 한국어
mixin tab(href, icon, label, active)
  a.tab(href=href class=active ? 'active' : '' title=label aria-label=label aria-current=(active ? 'page' : false))
    +icon(icon, 22)
    span.tab-label= label
nav.site(aria-label=t('Main'))
  .nav-left
    a.brand(href="/dashboard" aria-label="LanguageDrill")
      +brandMark(30)
      span.wordmark Language#[em Drill]
    if currentUser
      form.nav-search(method="GET" action="/community" role="search")
        input(type="hidden" name="tab" value="list")
        input(type="search" name="q" placeholder=t('Search sets') aria-label=t('Search sets'))
        +icon('search', 17)
  if currentUser
    .links
      //- Five tabs; every other page is under "More", so the bar stays
      //- readable. A page that lives under "More" lights that tab up.
      +tab('/dashboard', 'home', t('Home'), isActive('/dashboard') || here === '/')
      +tab('/community', 'users', t('Community'), isActive('/community'))
      +tab('/studio', 'studio', t('Studio'), isActive('/studio'))
      +tab('/chat', 'chat', t('Chat'), isActive('/chat'))
      +tab('/friends', 'friends', t('Friends'), isActive('/friends'))
      -
        var more = [
          { href: '/messages', icon: 'mail', label: t('Messages') },
          { href: '/schedule', icon: 'calendar', label: t('Schedule') },
          { href: '/assignments', icon: 'clipboard', label: t('Assignments') },
          { href: '/summary', icon: 'book', label: t('Meeting summary') },
          { href: '/call', icon: 'video', label: t('Video call') },
          { href: '/scan', icon: 'scan', label: t('Scan') },
          { href: '/passages', icon: 'book', label: t('Passages') },
          { href: '/progress', icon: 'chart', label: t('Progress') },
          { href: '/map', icon: 'pin', label: t('Around me') },
        ]
      - var inMore = more.some(function (item) { return isActive(item.href); })
      details.more-menu
        summary.tab(class=inMore ? 'active' : '' title=t('More') aria-label=t('More'))
          +icon('more', 22)
          span.tab-label= t('More')
          //- Lit by the script below when there are unread messages.
          span.unread-dot#nav-unread-dot(hidden)
        .menu
          each item in more
            a(href=item.href class=isActive(item.href) ? 'active' : '' aria-current=(isActive(item.href) ? 'page' : false))
              +icon(item.icon, 18)
              = item.label
              if item.href === '/messages'
                span.unread-count#nav-unread-count(hidden)
    .me
      +langSwitch
      if currentUser.role === 'admin'
        details.admin-menu
          summary(class=isActive('/admin') ? 'active' : '' title=t('Admin'))
            +icon('shield', 17)
            span= t('Admin')
            +icon('chevron', 14)
          .menu
            a(href="/admin/users" class=isActive('/admin/users') ? 'active' : '')
              +icon('users', 18)
              = t('Users & progress')
            a(href="/admin/audio" class=isActive('/admin/audio') ? 'active' : '')
              +icon('volume', 18)
              = t('Vocab audio')
            a(href="/admin/storage" class=isActive('/admin/storage') ? 'active' : '')
              +icon('database', 18)
              = t('Storage')
            a(href="/admin/listening" class=isActive('/admin/listening') ? 'active' : '')
              +icon('headphones', 18)
              = t('Listening (Dia2)')
      a.avatar(href="/profile" title=t('Profile - {email}', { email: currentUser.email }) aria-label=t('Profile - {email}', { email: currentUser.email }))
        = (currentUser.email || '?').charAt(0)
        //- Their profile image over the initial; gone again if it won't load.
        if myAvatar
          img(src=myAvatar alt="" onerror="this.remove()")
      form.inline(method="POST" action="/logout")
        button.link(type="submit" title=t('Log out') aria-label=t('Log out'))
          +icon('logout', 18)
  else
    span
    .me
      +langSwitch
      a.logout(href="/login")= t('Log in')
      a.cta(href="/register")= t('Get started')
//- Close the dropdown menus (More, Admin) on an outside click or Escape.
script.
  (function () {
    var menus = document.querySelectorAll('nav.site details');
    if (!menus.length) return;
    document.addEventListener('click', function (e) { menus.forEach(function (menu) { if (menu.open && !menu.contains(e.target)) menu.open = false; }); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') menus.forEach(function (menu) { menu.open = false; }); });
  })();

//- Incoming video calls ring on every page (src/public/call/incoming.js);
//- the /call page handles its own. If signaling-service is down the protocol
//- script comes back empty and incoming.js does nothing.
if currentUser && here !== '/call'
  script(src="/call/protocol.js" defer)
  script(src=asset('call/signalingClient.js') defer)
  script(src=asset('call/incoming.js') defer)

//- Unread messages: a dot on "More" and the number next to Messages in its
//- menu. One small request per page (GET /messages/unread); silent on failure.
if currentUser
  script.
    (function () {
      fetch('/messages/unread', { headers: { Accept: 'application/json' } })
        .then(function (res) { return res.ok ? res.json() : { count: 0 }; })
        .then(function (body) {
          var n = body.count || 0, dot = document.getElementById('nav-unread-dot'), count = document.getElementById('nav-unread-count');
          if (!n || !dot || !count) return;
          dot.hidden = false;
          count.hidden = false;
          count.textContent = n > 99 ? '99+' : String(n);
        })
        .catch(function () {});
    })();

//- A scheduled video call coming due pops up on whatever page the user is
//- on (src/public/schedule/reminder.js).
if currentUser
  script(src=asset('schedule/reminder.js') defer)
