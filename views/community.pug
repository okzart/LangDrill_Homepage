doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title LanguageDrill — Community
    include _style
    include mixins/itemBuilder
    style.
      .hint { font-size: 0.8rem; color: #666; margin: 0.25rem 0 0.75rem; }
      .word-picker { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.4rem; }
      .word-btn { margin: 0; padding: 0.3rem 0.6rem; border: 1px solid #ccc; border-radius: 999px; background: #fff; font-size: 0.85rem; cursor: pointer; }
      .word-btn.selected { background: #2c6bd9; border-color: #2c6bd9; color: #fff; }
      .tok-plain { font-size: 0.85rem; color: #666; }
      #itemList { padding-left: 1.2rem; margin: 0.75rem 0; }
      #itemList li { margin-bottom: 0.4rem; font-size: 0.9rem; }
      #itemList li.editing { background: #eef4ff; border-radius: 4px; padding: 0.1rem 0.4rem; margin-left: -0.4rem; }
      #itemList button { margin: 0 0 0 0.5rem; padding: 0.1rem 0.5rem; font-size: 0.8rem; }
      #cancelEditBtn { margin-left: 0.75rem; }
      #itemBuilder { background: #fafafa; }
      #itemBuilder .field[hidden] { display: none; }
      .ai-prompt { white-space: pre-wrap; font-family: monospace; font-size: 0.75rem; line-height: 1.4; background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 0.75rem; max-height: 320px; overflow-y: auto; }
      .copy-status { margin-left: 0.6rem; font-size: 0.8rem; color: #2c9c4a; }
      .tabs { display: flex; gap: 0.25rem; margin-bottom: 1rem; border-bottom: 1px solid #ddd; }
      .tabs a { padding: 0.5rem 1rem; text-decoration: none; color: #666; border-bottom: 2px solid transparent; margin-bottom: -1px; }
      .tabs a.active { color: #222; border-bottom-color: #2c6bd9; font-weight: 600; }
      .card .card-actions { margin-top: 0.5rem; display: flex; gap: 0.5rem; }
      .card .card-actions form { margin: 0; }
      .pager { justify-content: center; margin-top: 1rem; font-size: 0.9rem; }
      .pager span { color: #666; }
  body
    include _nav
    h1 Community sets

    if error
      .error= error
    if published
      .success Published.
    if deleted
      .success Unpublished.
    if updated
      .success Updated.

    section
      nav.tabs
        a(href="/community?tab=list" class=(tab === 'list' ? 'active' : '')) List
        a(href="/community?tab=create" class=(tab === 'create' ? 'active' : '')) Create

      if tab === 'list'
        form.row(method="GET" action="/community")
          input(type="hidden" name="tab" value="list")
          select(name="type")
            option(value="" selected=(type === '')) All types
            option(value="vocab" selected=(type === 'vocab')) vocab
            option(value="listening" selected=(type === 'listening')) listening
            option(value="writing" selected=(type === 'writing')) writing
          input(type="text" name="q" placeholder="search name/author/desc" value=q)
          button(type="submit") Search

      //- List tab: browse/search, each row with inline Update/Delete
      //- buttons. Ownership isn't exposed to the client (see
      //- routes/communityRoutes.js), so anyone can try to update/delete
      //- any visible set - the server enforces who actually owns it.
      if tab === 'list'
        if editError
          .error= editError
        if editSet
          h2 Editing: #{editSet.name || editSet.id}
          +itemBuilder(`/community/${editSet.id}/update`, editSet, 'Save changes')
          p
            a(href=`/community?${returnTo}`) ← Back to list
        else
          if sets.length === 0
            p No sets found.
          each set in sets
            .card
              h3
                a(href=`/community/${set.id}`)= set.name
              .meta #{set.type} · by #{set.author} · #{set.downloads} downloads · #{set.count} items
              p= set.desc
              .card-actions
                form.inline(method="GET" action="/community")
                  input(type="hidden" name="tab" value="list")
                  input(type="hidden" name="type" value=type)
                  input(type="hidden" name="q" value=q)
                  input(type="hidden" name="page" value=page)
                  input(type="hidden" name="limit" value=limit)
                  input(type="hidden" name="editId" value=set.id)
                  button(type="submit") Update
                form.inline(method="POST" action=`/community/${set.id}/delete` onsubmit="return confirm('Unpublish this set? This cannot be undone.')")
                  input(type="hidden" name="returnTo" value=returnTo)
                  button.danger(type="submit") Delete
          if total > 0
            .row.pager
              if page > 1
                a(href=`/community?${pagerBase}&page=${page - 1}`) ← Prev
              span Page #{page} of #{totalPages} (#{total} set#{total === 1 ? '' : 's'} total)
              if page < totalPages
                a(href=`/community?${pagerBase}&page=${page + 1}`) Next →

      //- Create tab: publish a brand-new set via the visual item builder.
      if tab === 'create'
        h2 Publish a new set
        +itemBuilder('/community/publish', editSet, 'Publish')

    script.
      (function () {
        var typeSelect = document.getElementById('type');
        var itemsTextarea = document.getElementById('items');
        if (!typeSelect || !itemsTextarea) return; // Plain list view (no row being edited) - nothing to wire up.

        var FIELD_CONFIG = {
          vocab: {
            subtypes: null,
            fields: ['ko', 'answer', 'blanks', 'keyko', 'source'],
          },
          listening: {
            subtypes: ['dictation', 'full', 'choice', 'order'],
            fieldsBySubtype: {
              dictation: ['answer', 'ko', 'blanks'],
              full: ['answer', 'ko'],
              choice: ['answer', 'ko', 'options'],
              order: ['answer', 'ko'],
            },
          },
          writing: {
            subtypes: ['compose', 'free', 'guided', 'correct', 'passage'],
            fieldsBySubtype: {
              compose: ['ko', 'model', 'keyvocab', 'tip'],
              free: ['model', 'keyvocab', 'tip'],
              guided: ['ko', 'model', 'keyvocab', 'tip'],
              correct: ['prompt', 'model', 'keyvocab', 'tip'],
              passage: ['ko', 'model', 'keyvocab', 'tip'],
            },
          },
        };

        var ALL_FIELDS = ['ko', 'answer', 'blanks', 'keyko', 'source', 'options', 'model', 'prompt', 'keyvocab', 'tip'];

        var subtypeWrap = document.getElementById('w-subtype');
        var subtypeSelect = document.getElementById('f-subtype');
        var itemList = document.getElementById('itemList');
        var itemsError = document.getElementById('itemsError');
        var addItemBtn = document.getElementById('addItemBtn');
        var cancelEditBtn = document.getElementById('cancelEditBtn');
        var blankPicker = document.getElementById('blankPicker');
        var answerInput = document.getElementById('f-answer');
        var bulkItemsTextarea = document.getElementById('bulkItems');
        var bulkItemsError = document.getElementById('bulkItemsError');
        var mergeBulkBtn = document.getElementById('mergeBulkBtn');
        var aiPromptDetails = document.getElementById('aiPromptDetails');
        var aiPromptText = document.getElementById('aiPromptText');
        var copyAiPromptBtn = document.getElementById('copyAiPromptBtn');
        var copyAiPromptStatus = document.getElementById('copyAiPromptStatus');

        var selectedBlankIndices = {};
        var editingIndex = null; // null = the builder is composing a new item

        function fieldsFor() {
          var type = typeSelect.value;
          var cfg = FIELD_CONFIG[type];
          if (!cfg) return [];
          if (!cfg.subtypes) return cfg.fields;
          return cfg.fieldsBySubtype[subtypeSelect.value] || [];
        }

        function getItems() {
          try {
            var parsed = JSON.parse(itemsTextarea.value || '[]');
            return Array.isArray(parsed) ? parsed : [];
          } catch (e) {
            return [];
          }
        }

        function setItems(items) {
          itemsTextarea.value = JSON.stringify(items, null, 2);
          renderItemList(items);
        }

        function summarize(item) {
          var type = typeSelect.value;
          if (type === 'vocab') return (item.ko || '') + ' → ' + (item.answer || '');
          if (type === 'listening') return '[' + (item.type || '') + '] ' + (item.answer || '');
          if (type === 'writing') return '[' + (item.type || '') + '] ' + (item.model || item.prompt || '');
          return JSON.stringify(item);
        }

        function renderItemList(items) {
          itemList.innerHTML = '';
          items.forEach(function (item, index) {
            var li = document.createElement('li');
            if (index === editingIndex) li.className = 'editing';
            var span = document.createElement('span');
            span.textContent = summarize(item);
            var editBtn = document.createElement('button');
            editBtn.type = 'button';
            editBtn.textContent = 'Edit';
            editBtn.addEventListener('click', function () {
              startEditing(index);
            });
            var removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.textContent = 'Remove';
            removeBtn.addEventListener('click', function () {
              var current = getItems();
              current.splice(index, 1);
              if (editingIndex === index) stopEditing();
              else if (editingIndex !== null && index < editingIndex) editingIndex -= 1;
              setItems(current);
            });
            li.appendChild(span);
            li.appendChild(editBtn);
            li.appendChild(removeBtn);
            itemList.appendChild(li);
          });
        }

        function updateAiPromptVisibility() {
          if (aiPromptDetails) aiPromptDetails.hidden = typeSelect.value !== 'vocab';
        }

        function updateSubtypeOptions() {
          var type = typeSelect.value;
          var cfg = FIELD_CONFIG[type];
          if (!cfg || !cfg.subtypes) {
            subtypeWrap.hidden = true;
            subtypeSelect.innerHTML = '';
            return;
          }
          subtypeWrap.hidden = false;
          subtypeSelect.innerHTML = '';
          cfg.subtypes.forEach(function (s) {
            var opt = document.createElement('option');
            opt.value = s;
            opt.textContent = s;
            subtypeSelect.appendChild(opt);
          });
        }

        function updateFieldVisibility() {
          var visible = fieldsFor();
          ALL_FIELDS.forEach(function (f) {
            var wrap = document.getElementById('w-' + f);
            if (wrap) wrap.hidden = visible.indexOf(f) === -1;
          });
          if (visible.indexOf('blanks') === -1) {
            selectedBlankIndices = {};
          } else {
            renderBlankPicker();
          }
        }

        // Mirrors LangDrillApp's tokenize() (lib/data/drill_data.dart) exactly -
        // see LangDrillApp/docs/14.blank-word-indexing.md for the full rule and
        // why a naive whitespace split silently blanks the wrong word once
        // content reaches the mobile app. wordIdx counts only letter/apostrophe
        // clusters; sentence punctuation is its own non-counted token, and
        // anything else (digits, hyphens, symbols) is skipped entirely and
        // consumes no index.
        function tokenize(sentence) {
          var re = /[A-Za-z']+|[.,!?;:]|\s+/g;
          var tokens = [];
          var wordIdx = 0;
          var m;
          while ((m = re.exec(sentence))) {
            var t = m[0];
            if (/^\s+$/.test(t)) tokens.push({ kind: 'space', text: t, wordIdx: -1 });
            else if (/^[.,!?;:]$/.test(t)) tokens.push({ kind: 'punct', text: t, wordIdx: -1 });
            else tokens.push({ kind: 'word', text: t, wordIdx: wordIdx++ });
          }
          return tokens;
        }

        function renderBlankPicker() {
          var text = answerInput.value || '';
          blankPicker.innerHTML = '';
          tokenize(text).forEach(function (t) {
            if (t.kind === 'space') return; // the picker's own flex gap supplies spacing
            if (t.kind === 'punct') {
              var span = document.createElement('span');
              span.className = 'tok-plain';
              span.textContent = t.text;
              blankPicker.appendChild(span);
              return;
            }
            var idx = t.wordIdx;
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'word-btn' + (selectedBlankIndices[idx] ? ' selected' : '');
            btn.textContent = t.text;
            btn.addEventListener('click', function () {
              selectedBlankIndices[idx] = !selectedBlankIndices[idx];
              btn.classList.toggle('selected');
            });
            blankPicker.appendChild(btn);
          });
        }

        function collectBlanks() {
          var text = answerInput.value || '';
          var blanks = [];
          tokenize(text).forEach(function (t) {
            if (t.kind === 'word' && selectedBlankIndices[t.wordIdx]) {
              blanks.push({ at: t.wordIdx, word: t.text });
            }
          });
          return blanks;
        }

        function showError(msg) {
          itemsError.textContent = msg;
          itemsError.hidden = false;
        }

        function clearError() {
          itemsError.hidden = true;
          itemsError.textContent = '';
        }

        function clearBuilderFields() {
          ['ko', 'answer', 'keyko', 'source', 'model', 'prompt', 'keyvocab', 'tip'].forEach(function (f) {
            var input = document.getElementById('f-' + f);
            if (input) input.value = '';
          });
          document.getElementById('f-options').value = '';
          selectedBlankIndices = {};
          blankPicker.innerHTML = '';
        }

        function setVal(f, v) {
          var el = document.getElementById('f-' + f);
          if (el) el.value = v || '';
        }

        // Reverse of buildItem(): loads an already-added item's fields back
        // into the builder so it can be edited in place instead of only
        // removed and re-added from scratch.
        function populateFieldsFromItem(item) {
          clearBuilderFields();
          var type = typeSelect.value;
          if (type === 'listening' || type === 'writing') {
            subtypeSelect.value = item.type || subtypeSelect.value;
            updateFieldVisibility();
          }
          if (type === 'vocab') {
            setVal('ko', item.ko);
            setVal('answer', item.answer);
            setVal('keyko', item.keyKo);
            setVal('source', item.source);
          } else if (type === 'listening') {
            setVal('answer', item.answer);
            setVal('ko', item.ko);
            if (item.options) document.getElementById('f-options').value = item.options.join('\n');
          } else if (type === 'writing') {
            setVal('ko', item.ko);
            setVal('prompt', item.prompt);
            setVal('model', item.model);
            setVal('tip', item.tip);
            if (item.keyVocab) document.getElementById('f-keyvocab').value = item.keyVocab.join(', ');
          }
          selectedBlankIndices = {};
          (item.blanks || []).forEach(function (b) { selectedBlankIndices[b.at] = true; });
          if (fieldsFor().indexOf('blanks') !== -1) renderBlankPicker();
        }

        function startEditing(index) {
          var item = getItems()[index];
          if (!item) return;
          clearError();
          editingIndex = index;
          populateFieldsFromItem(item);
          addItemBtn.textContent = 'Save changes to item';
          cancelEditBtn.hidden = false;
          renderItemList(getItems());
        }

        function stopEditing() {
          editingIndex = null;
          addItemBtn.textContent = '+ Add item';
          cancelEditBtn.hidden = true;
          clearBuilderFields();
        }

        function buildItem() {
          var type = typeSelect.value;
          var val = function (f) {
            var el = document.getElementById('f-' + f);
            return el ? el.value.trim() : '';
          };

          if (type === 'vocab') {
            if (!val('ko') || !val('answer')) return { error: 'Korean prompt and answer are required.' };
            var item = { ko: val('ko'), answer: val('answer') };
            if (val('keyko')) item.keyKo = val('keyko');
            var blanks = collectBlanks();
            if (blanks.length) item.blanks = blanks;
            if (val('source')) item.source = val('source');
            return { item: item };
          }

          if (type === 'listening') {
            var subtype = subtypeSelect.value;
            if (!val('answer')) return { error: 'Answer is required.' };
            var litem = { type: subtype, answer: val('answer') };
            if (val('ko')) litem.ko = val('ko');
            if (subtype === 'dictation') {
              var lblanks = collectBlanks();
              if (lblanks.length) litem.blanks = lblanks;
            }
            if (subtype === 'choice') {
              var options = document.getElementById('f-options').value
                .split('\n')
                .map(function (s) { return s.trim(); })
                .filter(Boolean);
              if (options.length < 2) return { error: 'Add at least two options (one per line).' };
              litem.options = options;
            }
            return { item: litem };
          }

          if (type === 'writing') {
            var wsubtype = subtypeSelect.value;
            if (!val('model')) return { error: 'Model answer is required.' };
            var witem = { type: wsubtype, model: val('model') };
            if ((wsubtype === 'compose' || wsubtype === 'guided' || wsubtype === 'passage') && val('ko')) {
              witem.ko = val('ko');
            }
            if (wsubtype === 'correct') {
              if (!val('prompt')) return { error: 'The incorrect sentence to fix is required.' };
              witem.prompt = val('prompt');
            }
            if (val('keyvocab')) {
              witem.keyVocab = val('keyvocab').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
            }
            if (val('tip')) witem.tip = val('tip');
            return { item: witem };
          }

          return { error: 'Unknown type.' };
        }

        addItemBtn.addEventListener('click', function () {
          clearError();
          var result = buildItem();
          if (result.error) {
            showError(result.error);
            return;
          }
          var items = getItems();
          if (editingIndex !== null) {
            items[editingIndex] = result.item;
          } else {
            items.push(result.item);
          }
          stopEditing();
          setItems(items);
        });

        cancelEditBtn.addEventListener('click', function () {
          clearError();
          stopEditing();
          renderItemList(getItems());
        });

        // Bulk-add: paste a JSON array of new items and merge it onto
        // whatever's already in the list (from the visual builder and/or
        // earlier merges), instead of replacing it like the raw #items
        // textarea below does.
        function showBulkError(msg) {
          bulkItemsError.textContent = msg;
          bulkItemsError.hidden = false;
        }

        mergeBulkBtn.addEventListener('click', function () {
          bulkItemsError.hidden = true;
          var parsed;
          try {
            parsed = JSON.parse(bulkItemsTextarea.value || '');
          } catch (e) {
            showBulkError('Invalid JSON: ' + e.message);
            return;
          }
          var isPlainObject = function (v) { return typeof v === 'object' && v !== null && !Array.isArray(v); };
          if (!Array.isArray(parsed) || !parsed.length || !parsed.every(isPlainObject)) {
            showBulkError('Must be a non-empty JSON array of item objects.');
            return;
          }
          setItems(getItems().concat(parsed));
          bulkItemsTextarea.value = '';
        });

        copyAiPromptBtn.addEventListener('click', function () {
          var text = aiPromptText.textContent;
          function showStatus(msg) {
            copyAiPromptStatus.textContent = msg;
            setTimeout(function () { copyAiPromptStatus.textContent = ''; }, 2500);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(
              function () { showStatus('Copied!'); },
              function () { showStatus('Could not copy automatically — select the text above and copy it manually.'); }
            );
          } else {
            showStatus('Select the text above and copy it manually (Ctrl/Cmd+C).');
          }
        });

        answerInput.addEventListener('input', function () {
          selectedBlankIndices = {};
          if (fieldsFor().indexOf('blanks') !== -1) renderBlankPicker();
        });

        typeSelect.addEventListener('change', function () {
          var items = getItems();
          if (items.length && !confirm('Changing type clears the items you already added. Continue?')) {
            return;
          }
          updateSubtypeOptions();
          updateFieldVisibility();
          updateAiPromptVisibility();
          stopEditing();
          setItems([]);
        });

        subtypeSelect.addEventListener('change', function () {
          updateFieldVisibility();
          clearBuilderFields();
        });

        updateSubtypeOptions();
        updateFieldVisibility();
        updateAiPromptVisibility();
        renderItemList(getItems());
      })();
