//- Chat with the self-hosted LLM (llm-service), optionally spoken aloud by
//- tts-service. The browser only ever talks to this server (see
//- src/routes/chatRoutes.js): messages go to POST /chat/completions, which
//- forwards them to the gateway's /api/llm route and streams the reply back
//- as Server-Sent Events; with "Speak replies" on, each finished sentence of
//- the reply goes to POST /chat/speech, which streams audio/mpeg from the
//- gateway's /api/tts route. The 🎤 button records the user's voice and sends
//- it to POST /chat/transcribe (→ gateway /api/stt, Whisper), putting the
//- transcript in the message box. Nothing is stored: the conversation lives
//- only in this page and audio only in memory while it's played or sent.
doctype html
html(lang=lang || "en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= 'LanguageDrill — ' + t('Chat')
    include _style
    style.
      .meta { font-size: 0.85rem; color: #666; margin-top: -0.5rem; }
      #system-prompt { min-height: 3rem; font-family: inherit; font-size: 0.9rem; }
      #prompt { min-height: 3.5rem; font-family: inherit; font-size: 1rem; }
      #messages { display: flex; flex-direction: column; gap: 0.75rem; min-height: 10rem; max-height: 60vh; overflow-y: auto; }
      .msg { padding: 0.6rem 0.8rem; border-radius: 8px; white-space: pre-wrap; word-wrap: break-word; line-height: 1.45; max-width: 85%; }
      .msg.user { align-self: flex-end; background: #1f6feb; color: #fff; }
      .msg.assistant { align-self: flex-start; background: #f1f1f1; }
      .msg.error { align-self: stretch; max-width: none; margin-bottom: 0; }
      .empty { color: #888; font-size: 0.9rem; text-align: center; margin: auto; }
      .hidden { display: none; }
      button:disabled { cursor: default; opacity: 0.5; }
      .speech { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; font-size: 0.85rem; }
      .speech label { display: flex; gap: 0.35rem; align-items: center; margin: 0; width: auto; }
      .speech input[type=checkbox] { width: auto; margin: 0; }
      .speech select { width: auto; max-width: 100%; margin: 0; }
      .speech .hint { color: #888; }
      .msg-actions { align-self: flex-start; margin-top: -0.5rem; }
      .msg-actions button { margin: 0; padding: 0.1rem 0.5rem; font-size: 0.8rem; }
      .composer-row { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-top: 0.5rem; }
      .composer-row button { margin: 0; }
      .composer-row label { display: flex; gap: 0.3rem; align-items: center; margin: 0; width: auto; font-size: 0.85rem; }
      .composer-row input[type=checkbox] { width: auto; margin: 0; }
      .composer-row select { width: auto; margin: 0; font-size: 0.85rem; padding: 0.3rem; }
      #btn-mic.recording { background: #fbe3e3; border: 1px solid #c0392b; color: #7a1f1f; }
      #mic-status { font-size: 0.85rem; color: #666; }
      #mic-status.error { color: #b00020; }
      .spacer { flex: 1; }
  body
    include _nav
    h1= t('Chat')
    if model
      p.meta= t('Model: {model}', { model: model })
    else if modelError
      .error= t('LLM service unavailable: {error}', { error: t(modelError) })

    section
      details
        summary= t('System prompt')
        textarea#system-prompt= t('You are a friendly, concise language tutor. When the user writes in a language they are learning, gently correct mistakes and explain briefly.')

    section.speech
      if voiceGroups
        label
          input#speak-toggle(type="checkbox")
          = t('🔊 Speak replies')
        label
          = t('Voice')
          select#voice
            each group in voiceGroups
              optgroup(label=group.language)
                each voice in group.voices
                  option(value=voice.id selected=voice.id === defaultVoice)= voice.label
        span.hint= t('Pick a voice in the language the tutor replies in (no Korean voices).')
      else
        span.hint= t("🔇 Speech unavailable: tts-service can't be reached through the gateway.")

    section
      #messages
        p.empty= t('Say something to start the conversation.')

    textarea#prompt(placeholder=t('Type a message (Enter to send, Shift+Enter for a new line) — or press 🎤 and speak.'))
    .composer-row
      button#btn-send.primary(type="button")= t('Send')
      button#btn-mic(type="button" title=t('Speak: click to start, click again to stop (max 60 s)'))= t('🎤 Speak')
      select#stt-lang(title=t('Language you will speak') aria-label=t('Language you will speak'))
        option(value="en")= t('English')
        option(value="ko") 한국어
        option(value="auto")= t('Auto-detect')
      label(title=t('Send the transcript right away instead of leaving it in the box'))
        input#auto-send(type="checkbox" checked)
        = t('Send after speaking')
      span#mic-status
      span.spacer
      button#btn-stop.hidden(type="button")= t('Stop')
      button#btn-clear(type="button")= t('New chat')

    script.
      const $ = (id) => document.getElementById(id);
      const messagesEl = $('messages');
      const promptEl = $('prompt');

      // /chat?scenario=... (e.g. from the Map page's "Practise with the AI
      // tutor") starts the chat with that role-play as the system prompt.
      const scenario = new URLSearchParams(location.search).get('scenario');
      if (scenario) $('system-prompt').value = scenario.slice(0, 800);

      // Conversation sent to the model on every turn: [{ role, content }].
      let history = [];
      let abortController = null;

      function addMessage(role, text) {
        messagesEl.querySelector('.empty')?.remove();
        const el = document.createElement('div');
        el.className = role === 'error' ? 'msg error error' : `msg ${role}`;
        el.textContent = text;
        messagesEl.appendChild(el);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        return el;
      }

      // A "🔊 Replay" button under a finished assistant reply.
      function addReplayButton(replyEl, text) {
        if (!speech.available || !text.trim()) return;
        const actions = document.createElement('div');
        actions.className = 'msg-actions';
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = t('🔊 Replay');
        button.addEventListener('click', () => {
          speech.stop();
          splitSentences(text).forEach((sentence) => speech.enqueue(sentence));
          updateStopButton();
        });
        actions.appendChild(button);
        replyEl.after(actions);
      }

      // ======================================================================
      // Speech: sentences are sent to POST /chat/speech one at a time (at
      // most PREFETCH requests ahead of what's playing) and played in order.
      // Where the browser's MediaSource supports audio/mpeg (Chrome, Edge,
      // Firefox) each sentence starts playing while its audio is still
      // arriving; elsewhere it plays once its audio has fully arrived.
      // Nothing is saved - the audio only lives in memory while it plays.
      // ======================================================================
      const PREFETCH = 2;
      const canStreamAudio = 'MediaSource' in window && MediaSource.isTypeSupported('audio/mpeg');

      const speech = {
        available: Boolean($('speak-toggle')),
        queue: [],        // [{ text, chunks: Uint8Array[], done, failed, started, onData }]
        audio: null,      // the <audio> currently playing
        playing: false,
        controller: new AbortController(),

        get enabled() {
          return this.available && $('speak-toggle').checked;
        },

        get active() {
          return this.playing || this.queue.length > 0;
        },

        enqueue(text) {
          const clean = cleanForSpeech(text);
          // Skip fragments with nothing to pronounce (e.g. a lone "**").
          if (!/[\p{L}\p{N}]/u.test(clean)) return;
          this.queue.push({ text: clean, chunks: [], done: false, failed: false, started: false, onData: null });
          this.fetchAhead();
          this.playNext();
        },

        // Starts fetching the next queued sentences, keeping at most
        // PREFETCH requests in flight.
        fetchAhead() {
          const inFlight = this.queue.filter((item) => item.started && !item.done).length;
          const waiting = this.queue.filter((item) => !item.started).slice(0, PREFETCH - inFlight);
          waiting.forEach((item) => this.fetchItem(item));
        },

        async fetchItem(item) {
          item.started = true;
          const { signal } = this.controller;
          try {
            const res = await fetch('/chat/speech', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ text: item.text, voice: $('voice').value }),
              signal,
            });
            if (res.status === 401) {
              window.location.href = '/login?next=/chat';
              return;
            }
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const reader = res.body.getReader();
            while (true) {
              const { value, done } = await reader.read();
              if (done) break;
              item.chunks.push(value);
              item.onData?.();
            }
          } catch (error) {
            if (error.name !== 'AbortError') console.warn('Speech failed for:', item.text, error);
            item.failed = true;
          } finally {
            item.done = true;
            item.onData?.();
            if (!signal.aborted) this.fetchAhead();
          }
        },

        async playNext() {
          if (this.playing || this.queue.length === 0) return;
          this.playing = true;
          const item = this.queue[0];
          const { signal } = this.controller;
          try {
            await (canStreamAudio ? this.playStreaming(item) : this.playWhenLoaded(item));
          } catch (error) {
            console.warn('Playback failed for:', item.text, error);
          }
          if (signal.aborted) return; // stop() already reset the queue
          this.queue.shift();
          this.playing = false;
          this.audio = null;
          this.fetchAhead();
          updateStopButton();
          this.playNext();
        },

        // Plays while the audio is still arriving: feeds each received
        // chunk into a MediaSource buffer as it lands.
        playStreaming(item) {
          // stop() swaps in a new controller, so check the one this
          // sentence started under.
          const { signal } = this.controller;
          return new Promise((resolve, reject) => {
            const mediaSource = new MediaSource();
            const audio = new Audio();
            this.audio = audio;
            audio.src = URL.createObjectURL(mediaSource);
            const finish = () => { URL.revokeObjectURL(audio.src); resolve(); };
            audio.addEventListener('ended', finish);
            audio.addEventListener('error', () => { URL.revokeObjectURL(audio.src); reject(audio.error); });
            audio.addEventListener('pause', () => { if (signal.aborted) finish(); });

            mediaSource.addEventListener('sourceopen', () => {
              const buffer = mediaSource.addSourceBuffer('audio/mpeg');
              let next = 0;
              const append = () => {
                if (buffer.updating || mediaSource.readyState !== 'open') return;
                if (next < item.chunks.length) {
                  buffer.appendBuffer(item.chunks[next++]);
                } else if (item.done) {
                  item.onData = null;
                  if (next === 0) return finish(); // nothing arrived (failed or aborted)
                  mediaSource.endOfStream();
                }
              };
              buffer.addEventListener('updateend', append);
              item.onData = append;
              append();
            }, { once: true });

            audio.play().catch(reject);
          });
        },

        // Fallback without MediaSource support: wait for the whole sentence,
        // then play it from an in-memory Blob.
        async playWhenLoaded(item) {
          if (!item.done) {
            await new Promise((resolve) => { item.onData = () => { if (item.done) resolve(); }; });
          }
          if (item.failed || item.chunks.length === 0) return;
          const { signal } = this.controller;
          const url = URL.createObjectURL(new Blob(item.chunks, { type: 'audio/mpeg' }));
          const audio = new Audio(url);
          this.audio = audio;
          try {
            await new Promise((resolve, reject) => {
              audio.addEventListener('ended', resolve);
              audio.addEventListener('pause', () => { if (signal.aborted) resolve(); });
              audio.addEventListener('error', () => reject(audio.error));
              audio.play().catch(reject);
            });
          } finally {
            URL.revokeObjectURL(url);
          }
        },

        // Silences everything: cancels in-flight requests (which also stops
        // tts-service generating them) and drops the queue.
        stop() {
          this.controller.abort();
          this.controller = new AbortController();
          this.audio?.pause();
          this.audio = null;
          this.queue = [];
          this.playing = false;
          updateStopButton();
        },
      };

      // Markdown the model likes to emit shouldn't be read out loud.
      function cleanForSpeech(text) {
        return text
          .replace(/```[\s\S]*?```/g, ' ')
          .replace(/[*_`#>|~]+/g, ' ')
          .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
          .replace(/\s+/g, ' ')
          .trim();
      }

      // Splits streamed text into speakable pieces as it arrives: a piece
      // ends at . ! ? (followed by a space), CJK 。！？, or a line break.
      // Very short pieces are held back and joined with the next one so
      // playback doesn't stutter.
      const MIN_PIECE = 20;
      const BOUNDARY = /[.!?…]+["'”’)\]]*\s+|[。！？]+|\n+/g;

      function createSentenceSplitter(onSentence) {
        let buffer = '';
        let pending = '';
        const emit = (piece, force) => {
          pending += piece;
          if (force || pending.trim().length >= MIN_PIECE) {
            if (pending.trim()) onSentence(pending.trim());
            pending = '';
          }
        };
        return {
          push(text) {
            buffer += text;
            let last = 0;
            for (const match of buffer.matchAll(BOUNDARY)) {
              const end = match.index + match[0].length;
              emit(buffer.slice(last, end), false);
              last = end;
            }
            buffer = buffer.slice(last);
          },
          flush() {
            emit(buffer, true);
            buffer = '';
          },
        };
      }

      function splitSentences(text) {
        const sentences = [];
        const splitter = createSentenceSplitter((sentence) => sentences.push(sentence));
        splitter.push(text);
        splitter.flush();
        return sentences;
      }

      // Stop is shown while a reply is streaming or speech is playing, and
      // stops both.
      function updateStopButton() {
        $('btn-stop').classList.toggle('hidden', !abortController && !speech.active);
      }

      function setBusy(busy) {
        $('btn-send').disabled = busy;
        updateStopButton();
      }

      // ======================================================================
      // Send a message and stream the reply (and speak it, if enabled)
      // ======================================================================
      async function send() {
        const text = promptEl.value.trim();
        if (!text || abortController) return;
        promptEl.value = '';
        speech.stop(); // a new question interrupts the previous answer

        // Keep a reference to this turn's conversation: "New chat" replaces
        // `history`, and a stopped reply must not leak into the new one.
        const conversation = history;
        conversation.push({ role: 'user', content: text });
        addMessage('user', text);
        const replyEl = addMessage('assistant', '…');

        const system = $('system-prompt').value.trim();
        const messages = system ? [{ role: 'system', content: system }, ...conversation] : conversation;
        const splitter = speech.enabled
          ? createSentenceSplitter((sentence) => { speech.enqueue(sentence); updateStopButton(); })
          : null;

        abortController = new AbortController();
        setBusy(true);
        let reply = '';
        try {
          const res = await fetch('/chat/completions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ messages }),
            signal: abortController.signal,
          });
          if (res.status === 401) {
            // Session expired: log in again and come back here.
            window.location.href = '/login?next=/chat';
            return;
          }
          if (!res.ok) {
            const body = await res.json().catch(() => ({}));
            throw new Error(body.error || `HTTP ${res.status}`);
          }

          // Parse the SSE stream: lines of "data: {json}", ending with "data: [DONE]".
          const reader = res.body.pipeThrough(new TextDecoderStream()).getReader();
          let buffer = '';
          while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            buffer += value;
            const lines = buffer.split('\n');
            buffer = lines.pop();
            for (const line of lines) {
              if (!line.startsWith('data: ')) continue;
              const data = line.slice(6).trim();
              if (data === '[DONE]') continue;
              const chunk = JSON.parse(data);
              if (chunk.error) throw new Error(chunk.error.message || JSON.stringify(chunk.error));
              const delta = chunk.choices?.[0]?.delta?.content ?? '';
              reply += delta;
              splitter?.push(delta);
              replyEl.textContent = reply || '…';
              messagesEl.scrollTop = messagesEl.scrollHeight;
            }
          }
          splitter?.flush();
          conversation.push({ role: 'assistant', content: reply });
          addReplayButton(replyEl, reply);
        } catch (error) {
          if (error.name === 'AbortError') {
            // Stopped by the user: keep what arrived so far as the reply.
            if (reply) {
              conversation.push({ role: 'assistant', content: reply });
              addReplayButton(replyEl, reply);
            } else {
              replyEl.remove();
              conversation.pop();
            }
          } else {
            replyEl.remove();
            conversation.pop();
            addMessage('error', t('Error: {message}', { message: error.message }));
          }
        } finally {
          abortController = null;
          setBusy(false);
          promptEl.focus();
        }
      }

      $('btn-send').addEventListener('click', send);
      $('btn-stop').addEventListener('click', () => {
        abortController?.abort();
        speech.stop();
      });
      $('btn-clear').addEventListener('click', () => {
        abortController?.abort();
        speech.stop();
        history = [];
        messagesEl.innerHTML = '';
        const empty = document.createElement('p');
        empty.className = 'empty';
        empty.textContent = t('Say something to start the conversation.');
        messagesEl.append(empty);
        promptEl.focus();
      });
      promptEl.addEventListener('keydown', (e) => {
        // isComposing: don't send while an IME (e.g. Korean) is mid-syllable.
        if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
          e.preventDefault();
          send();
        }
      });

      // ======================================================================
      // Voice input: record with MediaRecorder, transcribe via POST
      // /chat/transcribe (→ gateway /api/stt → Whisper), then fill the box
      // (and send, if "Send after speaking" is on). Browsers only allow the
      // microphone on HTTPS or localhost.
      // ======================================================================
      const MAX_RECORDING_MS = 60 * 1000;
      const micButton = $('btn-mic');
      const micStatus = $('mic-status');
      const micSupported = window.isSecureContext && !!navigator.mediaDevices?.getUserMedia && 'MediaRecorder' in window;
      let recorder = null;
      let recordTimer = null;

      function setMicStatus(text, isError = false) {
        micStatus.textContent = text;
        micStatus.classList.toggle('error', isError);
      }

      if (!micSupported) {
        micButton.disabled = true;
        micButton.title = window.isSecureContext
          ? t('This browser cannot record audio.')
          : t('The microphone only works over HTTPS or on localhost. Open this page via https:// (or localhost) to speak.');
        setMicStatus(window.isSecureContext ? '' : t('🎤 needs HTTPS or localhost'));
      }

      // webm/opus where supported (Chrome, Firefox, Edge), else mp4 (Safari).
      function recordingType() {
        for (const type of ['audio/webm;codecs=opus', 'audio/webm', 'audio/ogg;codecs=opus', 'audio/mp4']) {
          if (MediaRecorder.isTypeSupported(type)) return type;
        }
        return '';
      }

      async function startRecording() {
        let stream;
        try {
          stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        } catch (error) {
          setMicStatus(error.name === 'NotAllowedError' ? t('Microphone permission denied.') : t('Microphone unavailable: {message}', { message: error.message }), true);
          return;
        }
        speech.stop(); // don't record the tutor's own voice
        const type = recordingType();
        const chunks = [];
        recorder = new MediaRecorder(stream, type ? { mimeType: type } : undefined);
        recorder.addEventListener('dataavailable', (e) => { if (e.data.size > 0) chunks.push(e.data); });
        recorder.addEventListener('stop', () => {
          stream.getTracks().forEach((t) => t.stop());
          clearInterval(recordTimer);
          micButton.classList.remove('recording');
          micButton.textContent = t('🎤 Speak');
          const blob = new Blob(chunks, { type: (recorder.mimeType || type || 'audio/webm').split(';')[0] });
          recorder = null;
          transcribe(blob);
        });
        const started = Date.now();
        recorder.start();
        micButton.classList.add('recording');
        const tick = () => {
          const s = Math.floor((Date.now() - started) / 1000);
          micButton.textContent = t('⏹ Stop {time}', { time: `0:${String(s).padStart(2, '0')}` });
          if (Date.now() - started >= MAX_RECORDING_MS) stopRecording();
        };
        tick();
        recordTimer = setInterval(tick, 250);
        setMicStatus(t('Listening…'));
      }

      function stopRecording() {
        if (recorder && recorder.state !== 'inactive') recorder.stop();
      }

      async function transcribe(blob) {
        if (blob.size === 0) { setMicStatus(t('Nothing was recorded.'), true); return; }
        setMicStatus(t('Transcribing…'));
        micButton.disabled = true;
        try {
          const res = await fetch(`/chat/transcribe?language=${encodeURIComponent($('stt-lang').value)}`, {
            method: 'POST',
            headers: { 'Content-Type': blob.type || 'audio/webm' },
            body: blob,
          });
          if (res.status === 401) { window.location.href = '/login?next=/chat'; return; }
          const body = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(body.error || `HTTP ${res.status}`);
          const text = (body.text || '').trim();
          if (!text) { setMicStatus(t('No speech recognized — try again, a little closer to the mic.'), true); return; }
          setMicStatus('');
          const wasEmpty = promptEl.value.trim() === '';
          promptEl.value = wasEmpty ? text : `${promptEl.value.trimEnd()} ${text}`;
          // Auto-send only a fresh message, and not while a reply is streaming.
          if ($('auto-send').checked && wasEmpty && !abortController) send();
          else promptEl.focus();
        } catch (error) {
          setMicStatus(t("Couldn't transcribe: {message}", { message: error.message }), true);
        } finally {
          micButton.disabled = false;
        }
      }

      micButton.addEventListener('click', () => {
        if (!micSupported) return;
        if (recorder) stopRecording();
        else startRecording();
      });

      try {
        const lang = localStorage.getItem('chatSttLang');
        if (lang && [...$('stt-lang').options].some((o) => o.value === lang)) $('stt-lang').value = lang;
        $('auto-send').checked = localStorage.getItem('chatAutoSend') !== '0';
      } catch {}
      $('stt-lang').addEventListener('change', (e) => { try { localStorage.setItem('chatSttLang', e.target.value); } catch {} });
      $('auto-send').addEventListener('change', (e) => { try { localStorage.setItem('chatAutoSend', e.target.checked ? '1' : '0'); } catch {} });

      // Remember the speech toggle and voice per browser (a convenience only).
      if (speech.available) {
        try {
          $('speak-toggle').checked = localStorage.getItem('chatSpeak') === '1';
          const savedVoice = localStorage.getItem('chatVoice');
          if (savedVoice && [...$('voice').options].some((o) => o.value === savedVoice)) $('voice').value = savedVoice;
        } catch {}
        $('speak-toggle').addEventListener('change', (e) => {
          if (!e.target.checked) speech.stop();
          try { localStorage.setItem('chatSpeak', e.target.checked ? '1' : '0'); } catch {}
        });
        $('voice').addEventListener('change', (e) => {
          try { localStorage.setItem('chatVoice', e.target.value); } catch {}
        });
      }
      promptEl.focus();
