doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title LanguageDrill — Profile
    include _style
  body
    include _nav
    h1 Profile

    section
      table
        tr
          th ID
          td= profile.id
        tr
          th Email
          td= profile.email
        tr
          th Role
          td= profile.role
        tr
          th Created
          td= profile.createdAt
