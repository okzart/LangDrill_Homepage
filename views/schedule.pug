//- Schedule (see routes/scheduleRoutes.js): a month calendar of the video
//- calls this user has arranged with others. Pick a day, pick a time slot,
//- choose who and how long, and invite; the other person accepts or
//- declines, and an accepted call is on both calendars. Everything on the
//- page is drawn by src/public/schedule/schedule.js from /schedule/data, in
//- the browser's own time zone.
doctype html
html(lang=lang || "en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= 'LanguageDrill — ' + t('Schedule')
    include _style
    style.
      .hint { font-size: 0.82rem; color: var(--muted); }
      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
      .actions { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-top: 0.75rem; }
      .actions button { margin: 0; }
      .layout { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
      @media (max-width: 900px) { .layout { grid-template-columns: minmax(0, 1fr); } }
      .cal-head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem; }
      .cal-head h2 { margin: 0; flex: 1; font-size: 1.2rem; }
      .cal-head button { margin: 0; }
      .cal { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
      .cal .dow { padding: 0.2rem 0; font-size: 0.72rem; font-weight: 700; text-align: center; text-transform: uppercase; color: var(--muted); }
      .cal button.day { display: block; width: 100%; min-height: 4.6rem; margin: 0; padding: 0.3rem; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--text); font: inherit; text-align: left; vertical-align: top; cursor: pointer; }
      .cal button.day:hover { border-color: var(--accent); }
      .cal button.day.other { opacity: 0.45; }
      .cal button.day.past { background: #f6f7f9; }
      .cal button.day.today .num { display: inline-grid; place-items: center; min-width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--blue-700); color: #fff; }
      .cal button.day.selected { border-color: var(--blue-700); box-shadow: 0 0 0 2px var(--blue-100); }
      .cal .num { font-size: 0.82rem; font-weight: 600; }
      .cal .ev { display: block; margin-top: 2px; padding: 1px 4px; border-radius: 5px; background: var(--blue-100); color: var(--blue-800); font-size: 0.7rem; line-height: 1.25; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .cal .ev.pending { background: none; border: 1px dashed var(--blue-700); }
      .slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(4.4rem, 1fr)); gap: 4px; max-height: 15rem; overflow-y: auto; padding: 2px; }
      .slots button { margin: 0; padding: 0.3rem 0; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); font-size: 0.85rem; cursor: pointer; }
      .slots button:hover:not(:disabled) { border-color: var(--accent); }
      .slots button.on { background: var(--blue-700); border-color: var(--blue-700); color: #fff; }
      .slots button:disabled { opacity: 0.4; cursor: default; }
      .slots button.busy { text-decoration: line-through; }
      .panel { padding: 1rem; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
      .panel h3 { margin: 0 0 0.5rem; font-size: 1rem; }
      .panel + .panel { margin-top: 1rem; }
      ul.meet { list-style: none; margin: 0; padding: 0; }
      ul.meet li { padding: 0.55rem 0; border-bottom: 1px solid #eee; }
      ul.meet li:last-child { border-bottom: 0; }
      ul.meet .when { font-weight: 600; }
      ul.meet .who { font-size: 0.9rem; }
      ul.meet .note { font-size: 0.82rem; color: var(--muted); overflow-wrap: anywhere; }
      ul.meet .acts { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.35rem; }
      ul.meet .acts button, ul.meet .acts a.btn { margin: 0; }
      .tag { display: inline-block; margin-left: 0.4rem; padding: 0 0.45rem; border-radius: 999px; border: 1px solid #ddd; font-size: 0.7rem; color: #666; vertical-align: middle; }
      .empty { font-size: 0.88rem; color: var(--muted); }
  body
    include _nav
    h1= t('Schedule')
    p.hint= t('Arrange a video call with another user: pick a day and a time, invite them, and once they accept it is on both your calendars. When the time comes you are both told.')

    #sched-error.error(hidden)
    #sched-info.success(hidden)

    .layout
      div
        .cal-head
          button#cal-prev(type="button" aria-label=t('Previous month')) ‹
          h2#cal-title(aria-live="polite")
          button#cal-today(type="button")= t('Today')
          button#cal-next(type="button" aria-label=t('Next month')) ›
        #cal.cal(role="grid")

        .panel(style="margin-top: 1rem")
          h3#day-title= t('Pick a day in the calendar')
          #day-list
          #slot-box(hidden)
            label= t('Start time')
            #slots.slots
            p.hint#tz-note
            .grid2
              div
                label(for="invite-with")= t('With')
                select#invite-with
                  if preselect
                    option(value=preselect.id selected)= preselect.displayName
              div
                label(for="invite-minutes")= t('Length')
                select#invite-minutes
            label(for="invite-note")= t('Note (optional)')
            input#invite-note(type="text" maxlength="200" placeholder=t('e.g. Practise ordering at a restaurant'))
            .actions
              button#invite-send.primary(type="button" disabled)= t('Send invitation')
              span#invite-summary.hint

      div
        .panel
          h3= t('Invitations for you')
          ul.meet#list-incoming
        .panel
          h3= t('Upcoming calls')
          ul.meet#list-upcoming
        .panel
          h3= t('Waiting for their answer')
          ul.meet#list-outgoing

    script(src=asset('schedule/schedule.js'))
