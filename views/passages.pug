//- Example passages: the user picks expressions from a vocab drill set
//- (each with its example sentence and meaning, loaded via GET
//- /passages/sets/:id) and/or types their own; Content Sharing (via the
//- gateway's /api/passages) writes a passage that uses all of them in the
//- intended sense, narrates it, and translates it into Korean sentence by
//- sentence (shown under the passage, highlighted in sync with the audio). The result - text, MP3 (base64) and per-word timings - comes
//- back in one JSON response from POST /passages/generate (see
//- src/routes/passagesRoutes.js). The MP3 is played from memory only;
//- nothing is saved on the server or in the browser.
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title LanguageDrill — Passages
    include _style
    style.
      .picker-head { display: flex; gap: 0.5rem; align-items: end; flex-wrap: wrap; }
      .picker-head > div { flex: 1; min-width: 180px; }
      #items { max-height: 22rem; overflow-y: auto; border: 1px solid #eee; border-radius: 6px; margin-top: 0.5rem; }
      #items label { display: flex; gap: 0.6rem; align-items: flex-start; margin: 0; padding: 0.5rem 0.6rem; border-bottom: 1px solid #f3f3f3; cursor: pointer; }
      #items label:hover { background: #fafafa; }
      #items input { width: auto; margin-top: 0.2rem; }
      #items .expr-name { font-weight: 600; color: #1f4fb0; }
      #items .ko { color: #555; font-size: 0.85rem; }
      #items .example { color: #666; font-size: 0.85rem; font-style: italic; }
      #items label.added { opacity: 0.55; }
      .picker-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
      .picker-actions button { margin-top: 0.5rem; }
      #selected { margin: 0.5rem 0 0; padding: 0; list-style: none; }
      #selected li { display: grid; grid-template-columns: 1.2fr 1fr 2fr auto; gap: 0.4rem; align-items: center; padding: 0.35rem 0; border-bottom: 1px solid #f3f3f3; }
      #selected li input { margin: 0; font-size: 0.9rem; }
      #selected li input.expr-input { font-weight: 600; }
      #selected li button { margin: 0; padding: 0.2rem 0.55rem; }
      #selected .empty { display: block; color: #888; font-size: 0.9rem; border: 0; }
      @media (max-width: 640px) { #selected li { grid-template-columns: 1fr auto; } #selected li .opt { grid-column: 1 / -1; } }
      .count { font-size: 0.85rem; color: #666; font-weight: normal; }
      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
      @media (max-width: 560px) { .grid2 { grid-template-columns: 1fr; } }
      .hint { font-size: 0.8rem; color: #666; margin: 0.25rem 0 0; }
      #status { font-size: 0.9rem; color: #666; margin-left: 0.5rem; }
      .hidden { display: none; }
      .player { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
      .player audio { flex: 1; min-width: 240px; }
      .player .speed button { margin: 0; padding: 0.3rem 0.6rem; }
      .player .speed button.active { background: #222; color: #fff; }
      .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.75rem 0 0; padding: 0; list-style: none; }
      .chips button { margin: 0; padding: 0.3rem 0.6rem; border: 1px solid #1f6feb; border-radius: 999px; background: #eef4ff; color: #1f4fb0; font-size: 0.85rem; }
      .chips button small { color: #555; }
      #passage { white-space: pre-wrap; font-size: 1.1rem; line-height: 1.9; margin-top: 1rem; }
      #passage .w { cursor: pointer; border-radius: 3px; padding: 0 1px; }
      #passage .w:hover { background: #f1f1f1; }
      #passage .in-sentence { background: #f6f8fb; }
      #passage .expr { color: #1f4fb0; font-weight: 600; border-bottom: 2px solid #9db8f0; }
      #passage .w.current { background: #ffe58a; }
      .meta { font-size: 0.8rem; color: #666; margin-top: 0.75rem; }
      .show-ko { display: flex; gap: 0.35rem; align-items: center; margin: 0; font-size: 0.85rem; width: auto; }
      .show-ko input { width: auto; margin: 0; }
      #translation-box { margin-top: 1.25rem; padding-top: 0.75rem; border-top: 1px dashed #ddd; }
      #translation-box h3 { font-size: 0.9rem; color: #666; margin: 0 0 0.4rem; font-weight: 600; }
      #translation { white-space: pre-wrap; font-size: 1rem; line-height: 1.85; color: #333; }
      #translation .ko-s { cursor: pointer; border-radius: 3px; padding: 0 1px; }
      #translation .ko-s:hover { background: #f1f1f1; }
      #translation .ko-s.current { background: #fff3c4; }
      #translation .ko-s.missing { color: #999; font-style: italic; }
  body
    include _nav
    h1 Passages
    p Pick expressions from a vocab drill set or type your own. You'll get a short passage that uses every one of them — in the sense shown by each example sentence — read aloud, with each word highlighted as it's spoken.

    if vocabSets && vocabSets.length
      section
        h2 Pick from a vocab drill set
        .picker-head
          div
            label(for="set") Vocab set
            select#set
              option(value="") — choose a set —
              each set in vocabSets
                option(value=set.id)= `${set.name} (${set.count} items${set.author ? ` · ${set.author}` : ''})`
          div
            label(for="filter") Search items
            input#filter(type="search" placeholder="word, sentence or 한국어" disabled)
        #items.hidden
        .picker-actions
          button#btn-add-checked(type="button" disabled) Add checked
          button#btn-select-all(type="button" disabled) Check all shown
          span.hint#picker-status
    else if vocabSets
      p.hint No vocab drill sets have been published yet — type expressions below.

    section
      form#form
        h2 Expressions for the passage #[span.count#count 0 / 15]
        p.hint Each expression can carry a meaning and an example sentence; the passage uses the expression in that sense. Forms may change (e.g. "take off" → "took off"). Placeholders like "one's" are fine.
        ul#selected
        .picker-actions
          button#btn-add-row(type="button") + Add expression
          button#btn-clear-rows(type="button") Clear
        .grid2
          div
            label(for="level") Level
            select#level
              option(value="beginner") Beginner
              option(value="intermediate" selected) Intermediate
              option(value="advanced") Advanced
          div
            if voiceOptions
              label(for="voice") Voice
              select#voice
                each v in voiceOptions.voices
                  option(value=v.id selected=(v.id === voiceOptions.default))= v.label + (v.id === voiceOptions.default ? ' — default' : '')
            else
              p.hint Voice list unavailable right now; the default voice will be used.
        .row
          button#btn-generate(type="submit" disabled) Generate
          span#status

    #error.error.hidden

    section#result.hidden
      .player
        audio#audio(controls preload="auto")
        .speed
          button(type="button" data-rate="0.75") 0.75×
          button.active(type="button" data-rate="1") 1×
          button(type="button" data-rate="1.25") 1.25×
        label.show-ko
          input#show-ko(type="checkbox" checked)
          | Show Korean
      ul#chips.chips
      #passage
      #translation-box
        h3 한국어 번역
        #translation
      p.meta#meta

    script.
      const $ = (id) => document.getElementById(id);
      const audio = $('audio');
      const passageEl = $('passage');
      let audioUrl = null;
      let words = [];         // response.words, in order
      let wordEls = [];       // the <span> for each entry of `words`
      let sentenceOfWord = []; // sentence index for each word
      let sentences = [];      // response.sentences (with .ko translations)
      let koEls = [];          // the Korean <span> for each sentence
      let current = -1;
      let request = null;

      function showError(message) {
        $('error').textContent = message;
        $('error').classList.toggle('hidden', !message);
      }

      // ======================================================================
      // Expressions for the passage: [{ expression, meaning, example }]
      // ======================================================================
      const MAX = 15;
      let selected = [];

      const keyOf = (expression) => expression.trim().toLowerCase();

      // Adds entries, skipping duplicates and anything past MAX. Returns how
      // many were skipped for being over the limit.
      function addSelected(entries) {
        let overflow = 0;
        for (const entry of entries) {
          if (entry.expression && selected.some((s) => keyOf(s.expression) === keyOf(entry.expression))) continue;
          if (selected.length >= MAX) { overflow++; continue; }
          selected.push({ expression: entry.expression || '', meaning: entry.meaning || '', example: entry.example || '' });
        }
        renderSelected();
        return overflow;
      }

      function renderSelected() {
        const list = $('selected');
        list.textContent = '';
        if (selected.length === 0) {
          const li = document.createElement('li');
          li.className = 'empty';
          li.textContent = 'No expressions yet — pick some from a drill set above or add your own.';
          list.append(li);
        }
        selected.forEach((entry, i) => {
          const li = document.createElement('li');
          const field = (name, placeholder, cls) => {
            const input = document.createElement('input');
            input.value = entry[name];
            input.placeholder = placeholder;
            input.className = cls;
            input.setAttribute('aria-label', placeholder);
            input.addEventListener('input', () => { entry[name] = input.value; updateCounts(); });
            return input;
          };
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.textContent = '×';
          remove.title = 'Remove';
          remove.addEventListener('click', () => { selected.splice(i, 1); renderSelected(); });
          li.append(
            field('expression', 'expression, e.g. take off', 'expr-input'),
            field('meaning', 'meaning (optional)', 'opt'),
            field('example', 'example sentence (optional)', 'opt'),
            remove
          );
          list.append(li);
        });
        updateCounts();
      }

      function updateCounts() {
        const usable = selected.filter((s) => s.expression.trim()).length;
        $('count').textContent = `${usable} / ${MAX}`;
        $('btn-generate').disabled = usable === 0 || request !== null;
        $('btn-add-row').disabled = selected.length >= MAX;
        markAdded();
      }

      $('btn-add-row').addEventListener('click', () => {
        addSelected([{ expression: '' }]);
        const inputs = document.querySelectorAll('#selected .expr-input');
        inputs[inputs.length - 1]?.focus();
      });
      $('btn-clear-rows').addEventListener('click', () => { selected = []; renderSelected(); });

      // ======================================================================
      // Picker: a vocab drill set's items (GET /passages/sets/:id)
      // ======================================================================
      let setItems = [];
      const setSelect = $('set');

      function markAdded() {
        document.querySelectorAll('#items label').forEach((label) => {
          const item = setItems[Number(label.dataset.i)];
          label.classList.toggle('added', selected.some((s) => keyOf(s.expression) === keyOf(item.expression)));
        });
      }

      function renderItems() {
        const box = $('items');
        box.textContent = '';
        setItems.forEach((item, i) => {
          const label = document.createElement('label');
          label.dataset.i = i;
          label.dataset.search = `${item.expression} ${item.example} ${item.meaning} ${item.ko}`.toLowerCase();
          const box2 = document.createElement('input');
          box2.type = 'checkbox';
          const text = document.createElement('div');
          const name = document.createElement('div');
          name.className = 'expr-name';
          name.textContent = item.expression;
          const ko = document.createElement('div');
          ko.className = 'ko';
          ko.textContent = item.meaning && item.meaning !== item.ko ? `${item.meaning} — ${item.ko}` : item.ko || item.meaning;
          const example = document.createElement('div');
          example.className = 'example';
          example.textContent = item.example;
          text.append(name, ko, example);
          label.append(box2, text);
          box.append(label);
        });
        box.classList.toggle('hidden', setItems.length === 0);
        applyFilter();
        markAdded();
      }

      function applyFilter() {
        const q = ($('filter')?.value || '').trim().toLowerCase();
        document.querySelectorAll('#items label').forEach((label) => {
          label.classList.toggle('hidden', q !== '' && !label.dataset.search.includes(q));
        });
      }

      setSelect?.addEventListener('change', async () => {
        setItems = [];
        renderItems();
        $('picker-status').textContent = '';
        const id = setSelect.value;
        for (const b of ['btn-add-checked', 'btn-select-all']) $(b).disabled = !id;
        $('filter').disabled = !id;
        if (!id) return;
        $('picker-status').textContent = 'Loading…';
        try {
          const res = await fetch(`/passages/sets/${encodeURIComponent(id)}`);
          if (res.status === 401) { window.location.href = '/login?next=/passages'; return; }
          const body = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(body.error || `HTTP ${res.status}`);
          if (setSelect.value !== id) return; // another set was chosen meanwhile
          setItems = body.items;
          renderItems();
          $('picker-status').textContent = setItems.length ? `${setItems.length} items` : 'This set has no items with blanks to use.';
        } catch (error) {
          $('picker-status').textContent = `Could not load the set: ${error.message}`;
        }
      });

      $('filter')?.addEventListener('input', applyFilter);

      $('btn-select-all')?.addEventListener('click', () => {
        const room = MAX - selected.length;
        let n = 0;
        document.querySelectorAll('#items label:not(.hidden):not(.added) input').forEach((box) => {
          box.checked = n < room;
          if (box.checked) n++;
        });
        $('picker-status').textContent = n < room ? '' : `Checked ${n} — the passage takes at most ${MAX} expressions.`;
      });

      $('btn-add-checked')?.addEventListener('click', () => {
        const checked = [...document.querySelectorAll('#items input:checked')];
        const overflow = addSelected(checked.map((box) => setItems[Number(box.closest('label').dataset.i)]));
        checked.forEach((box) => { box.checked = false; });
        $('picker-status').textContent = overflow ? `${overflow} not added — at most ${MAX} expressions per passage.` : '';
      });

      renderSelected();

      // ======================================================================
      // Generate
      // ======================================================================
      $('form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const expressions = selected
          .filter((s) => s.expression.trim())
          .map((s) => ({ expression: s.expression.trim(), meaning: s.meaning.trim() || undefined, example: s.example.trim() || undefined }));
        if (expressions.length === 0) return;
        request?.abort();
        request = new AbortController();
        showError('');
        $('btn-generate').disabled = true;
        $('status').textContent = `Writing a passage with ${expressions.length} expression${expressions.length > 1 ? 's' : ''} , recording and translating it… (usually 5–15 seconds)`;
        try {
          const res = await fetch('/passages/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ expressions, level: $('level').value, voice: $('voice')?.value }),
            signal: request.signal,
          });
          if (res.status === 401) {
            window.location.href = '/login?next=/passages';
            return;
          }
          const body = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(body.error || `HTTP ${res.status}`);
          show(body);
          $('status').textContent = '';
        } catch (error) {
          if (error.name === 'AbortError') return;
          $('status').textContent = '';
          showError(error.message);
        } finally {
          request = null;
          updateCounts();
        }
      });

      // ======================================================================
      // Render a result: audio from memory, text as clickable word spans
      // ======================================================================
      function show(result) {
        audio.pause();
        if (audioUrl) URL.revokeObjectURL(audioUrl);
        const bytes = Uint8Array.from(atob(result.audio.base64), (c) => c.charCodeAt(0));
        audioUrl = URL.createObjectURL(new Blob([bytes], { type: result.audio.mimeType }));
        audio.src = audioUrl;
        audio.playbackRate = Number(document.querySelector('.speed .active').dataset.rate);

        // Build the passage: text between words stays plain text (spaces,
        // punctuation, paragraph breaks), each word is a span.
        words = result.words;
        passageEl.textContent = '';
        wordEls = [];
        let pos = 0;
        words.forEach((word, i) => {
          if (word.start > pos) passageEl.append(result.text.slice(pos, word.start));
          const span = document.createElement('span');
          span.className = word.expression === undefined ? 'w' : 'w expr';
          span.textContent = result.text.slice(word.start, word.end);
          span.dataset.i = i;
          if (word.expression !== undefined) span.title = `Expression: ${result.expressions[word.expression].expression}`;
          passageEl.append(span);
          wordEls.push(span);
          pos = word.end;
        });
        if (pos < result.text.length) passageEl.append(result.text.slice(pos));

        sentences = result.sentences;
        sentenceOfWord = words.map((word) =>
          sentences.findIndex((s) => word.start >= s.start && word.end <= s.end)
        );
        current = -1;
        renderTranslation(result);

        // One chip per expression; clicking plays from its first use.
        $('chips').textContent = '';
        result.expressions.forEach((entry) => {
          const first = entry.occurrences[0];
          const li = document.createElement('li');
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = entry.expression;
          button.title = [entry.meaning, entry.example && `e.g. ${entry.example}`].filter(Boolean).join('\n');
          if (first && first.text.toLowerCase() !== entry.expression.toLowerCase()) {
            const small = document.createElement('small');
            small.textContent = ` → ${first.text}`;
            button.append(small);
          }
          button.addEventListener('click', () => {
            const i = words.findIndex((w) => w.start >= first.start);
            if (i !== -1) seekTo(i);
          });
          li.append(button);
          $('chips').append(li);
        });

        $('meta').textContent = `${result.words.length} words · ${formatTime(result.audio.duration)} · voice ${result.voice} · ${result.level}. `
          + 'Sentence timing is exact; word highlighting is approximate. '
          + (result.translation && !result.translation.complete ? 'Some sentences could not be translated. ' : '')
          + (!result.translation ? 'Korean translation is unavailable this time. ' : '')
          + 'Nothing is saved — generating again replaces this passage.';
        $('result').classList.remove('hidden');
        $('result').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // Korean translation: one span per sentence, paragraph breaks where the
      // English has them; clicking a sentence plays it from its start.
      function renderTranslation(result) {
        const box = $('translation');
        box.textContent = '';
        koEls = [];
        const hasKo = result.translation && sentences.some((s) => s.ko);
        $('translation-box').dataset.available = hasKo ? 'yes' : 'no';
        applyShowKo();
        if (!hasKo) return;
        sentences.forEach((sentence, i) => {
          if (i > 0) box.append(result.text.slice(sentences[i - 1].end, sentence.start).includes('\n') ? '\n\n' : ' ');
          const span = document.createElement('span');
          span.className = sentence.ko ? 'ko-s' : 'ko-s missing';
          span.textContent = sentence.ko || '(번역 없음)';
          span.title = sentence.text;
          span.addEventListener('click', () => {
            const first = sentenceOfWord.indexOf(i);
            if (first !== -1) seekTo(first);
          });
          box.append(span);
          koEls.push(span);
        });
      }

      function applyShowKo() {
        const available = $('translation-box').dataset.available === 'yes';
        $('translation-box').classList.toggle('hidden', !available || !$('show-ko').checked);
        $('show-ko').closest('label').classList.toggle('hidden', !available);
      }

      try { $('show-ko').checked = localStorage.getItem('passagesShowKo') !== '0'; } catch {}
      $('show-ko').addEventListener('change', () => {
        applyShowKo();
        try { localStorage.setItem('passagesShowKo', $('show-ko').checked ? '1' : '0'); } catch {}
      });

      function formatTime(seconds) {
        return `${Math.floor(seconds / 60)}:${String(Math.round(seconds % 60)).padStart(2, '0')}`;
      }

      // ======================================================================
      // Highlight the word being spoken
      // ======================================================================
      // Last word whose startTime <= t (binary search), or -1 before the first.
      function wordAt(t) {
        let lo = 0, hi = words.length - 1, found = -1;
        while (lo <= hi) {
          const mid = (lo + hi) >> 1;
          if (words[mid].startTime <= t) { found = mid; lo = mid + 1; } else { hi = mid - 1; }
        }
        // Between sentences (trailing silence) nothing is highlighted.
        if (found !== -1 && t > words[found].endTime + 0.35) return -1;
        return found;
      }

      function highlight(i) {
        if (i === current) return;
        const oldSentence = current === -1 ? -1 : sentenceOfWord[current];
        const newSentence = i === -1 ? -1 : sentenceOfWord[i];
        if (current !== -1) wordEls[current].classList.remove('current');
        if (oldSentence !== newSentence) {
          if (oldSentence !== -1) koEls[oldSentence]?.classList.remove('current');
          if (newSentence !== -1) koEls[newSentence]?.classList.add('current');
          wordEls.forEach((el, k) => {
            if (sentenceOfWord[k] === oldSentence) el.classList.remove('in-sentence');
            if (sentenceOfWord[k] === newSentence && newSentence !== -1) el.classList.add('in-sentence');
          });
        }
        if (i !== -1) wordEls[i].classList.add('current');
        current = i;
      }

      let frame = null;
      function tick() {
        highlight(wordAt(audio.currentTime));
        frame = audio.paused ? null : requestAnimationFrame(tick);
      }
      audio.addEventListener('play', () => { if (!frame) frame = requestAnimationFrame(tick); });
      audio.addEventListener('seeked', () => highlight(wordAt(audio.currentTime)));
      audio.addEventListener('ended', () => highlight(-1));

      function seekTo(i) {
        audio.currentTime = words[i].startTime;
        highlight(i);
        audio.play();
      }
      passageEl.addEventListener('click', (e) => {
        const i = e.target.closest('.w')?.dataset.i;
        if (i !== undefined) seekTo(Number(i));
      });

      document.querySelectorAll('.speed button').forEach((button) => {
        button.addEventListener('click', () => {
          document.querySelectorAll('.speed button').forEach((b) => b.classList.toggle('active', b === button));
          audio.playbackRate = Number(button.dataset.rate);
        });
      });

      window.addEventListener('pagehide', () => { if (audioUrl) URL.revokeObjectURL(audioUrl); });
