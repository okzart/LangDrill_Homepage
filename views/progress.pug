//- The caller's own progress as a dashboard (views/mixins/progressCharts.pug).
//- Read-only: progress is recorded by the app as you practice. Admins get an
//- Edit button that opens the admin editor for their own record.
doctype html
html(lang=lang || "en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= 'LanguageDrill — ' + t('Progress')
    include _style
    style.
      .page-head { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
      .page-head h1 { margin-right: auto; }
      .page-head .btn { margin: 0; }
      .muted { color: #898781; font-size: 0.85rem; }
  body
    include _nav
    include mixins/progressCharts
    .page-head
      h1= t('Your progress')
      if isAdmin
        a.btn(href=`/admin/users/${encodeURIComponent(userId)}/progress`)= t('Edit')
    p.muted
      = t('Updated as you practice in the app.')
      if progress.lastStudyDate
        = ' ' + t('Last studied {date}.', { date: new Date(progress.lastStudyDate).toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) })
      if progress.targetLanguage
        = ' ' + t('Learning: {lang}.', { lang: progress.targetLanguage })

    +progressCharts(progress)
