//- Shared by views/community.pug's Create tab and the inline "Update"
//- editor on a List tab row - same name/desc/author/type fields plus the
//- visual per-item builder (see the script in community.pug), the only
//- difference being formAction and whichever values `prefill` seeds the
//- fields with (null for a blank Create form). Only one call ever renders
//- per page load (Create tab, or a List row being edited), so the fixed
//- element ids below (#type, #items, #f-*, ...) never collide.
mixin itemBuilder(formAction, prefill, submitLabel)
  - var p = prefill || {}
  - var itemsJson = p.itemsRaw !== undefined ? p.itemsRaw : JSON.stringify(p.items || [], null, 2)
  form(method="POST" action=formAction)
    if p.returnTo
      input(type="hidden" name="returnTo" value=p.returnTo)
    label(for="type") Type
    select#type(name="type")
      option(value="vocab" selected=(p.type === 'vocab' || !p.type)) vocab
      option(value="listening" selected=(p.type === 'listening')) listening
      option(value="writing" selected=(p.type === 'writing')) writing
    label(for="name") Name
    input#name(type="text" name="name" required value=p.name)
    label(for="desc") Description
    input#desc(type="text" name="desc" value=p.desc)
    label(for="author") Author (display name)
    input#author(type="text" name="author" value=p.author placeholder=currentUser.email)

    h3 Items
    p.hint Fill in the fields below for one item, then click "Add item". Repeat for every item — no JSON needed.

    #itemBuilder.card
      .field#w-subtype(hidden)
        label(for="f-subtype") Item type
        select#f-subtype

      .field#w-ko
        label(for="f-ko") Korean prompt
        input#f-ko(type="text")

      .field#w-answer
        label(for="f-answer") Answer / correct sentence
        input#f-answer(type="text")

      .field#w-blanks(hidden)
        label Click the words to hide as blanks (optional)
        #blankPicker.word-picker

      .field#w-keyko(hidden)
        label(for="f-keyko") Key Korean keyword (optional)
        input#f-keyko(type="text")

      .field#w-source(hidden)
        label(for="f-source") Source (optional)
        input#f-source(type="text")

      .field#w-options(hidden)
        label(for="f-options") Options — one per line, include the correct answer too
        textarea#f-options

      .field#w-model(hidden)
        label(for="f-model") Model answer (gold standard)
        input#f-model(type="text")

      .field#w-prompt(hidden)
        label(for="f-prompt") Incorrect sentence to fix
        input#f-prompt(type="text")

      .field#w-keyvocab(hidden)
        label(for="f-keyvocab") Must-use words (comma-separated, optional)
        input#f-keyvocab(type="text")

      .field#w-tip(hidden)
        label(for="f-tip") Grammar tip (optional)
        input#f-tip(type="text")

      #itemsError.error(hidden)
      button#addItemBtn(type="button") + Add item
      button#cancelEditBtn.link(type="button" hidden) Cancel edit

    ol#itemList

    details#aiPromptDetails
      summary Generate items with AI first (optional)
      p.hint Copy this prompt into any AI chat tool, paste your own source text (an article, word list, topic) at the bottom of it, then paste the JSON array it returns into "Bulk add via JSON" below.
      pre#aiPromptText.ai-prompt.
        You will generate vocabulary/sentence-drill items for a Korean-to-English
        language learning app, as a single JSON array. Output ONLY the JSON array —
        no markdown code fences, no commentary, no trailing text.

        Generate [NUMBER] items from the CONTENT given at the end of this prompt.
        Each item should teach one useful, natural English sentence drawn from or
        inspired by that content, at a [DIFFICULTY: e.g. intermediate / high-school]
        level.

        Each item is an object with these fields:

        - "ko" (required, string): a natural Korean prompt/meaning the learner sees
          first — either a translation of the English sentence or a question that
          the English sentence answers.
        - "answer" (required, string): the full, correct English sentence. Natural,
          grammatical, one sentence.
        - "keyKo" (optional, string): the specific Korean word/phrase that
          corresponds to the word(s) you choose to blank out in "answer" — the key
          vocabulary or grammar point being tested.
        - "blanks" (optional, array of {"at": number, "word": string}): the word(s)
          in "answer" to hide as blanks during practice. Pick 1-2 words that are the
          actual teaching point (a phrasal verb, a tricky preposition, the target
          vocabulary word) — not random words.
        - "source" (optional, string): a short attribution, e.g. the title/topic of
          the CONTENT below.

        CRITICAL — how to compute "at" and "word" for blanks:
        "at" counts only letter/apostrophe clusters in "answer" (a run of a-z,
        A-Z, or ' — i.e. a normal English word), 0-based, in reading order.
        Sentence punctuation (. , ! ? ; :) is its own unit, is NEVER attached
        to "word", and never gets counted. Anything else that isn't a letter,
        apostrophe, one of . , ! ? ; : , or whitespace — a digit, hyphen, $,
        quotation mark, etc. — is skipped entirely: it does not become a unit
        and does NOT consume an index either.

        Worked example:
          answer = "Where is the boarding gate?"
          word units -> ["Where", "is", "the", "boarding", "gate"]
          index:            0       1     2         3          4
          ("?" is its own punctuation unit — not attached to "gate", not counted)
          Blanking "boarding" -> {"at": 3, "word": "boarding"}
          Blanking "gate"     -> {"at": 4, "word": "gate"}   <- no "?" in "word"

        Worked example with a number in the sentence (the case people get wrong):
          answer = "Could you wake me up at 6 o'clock?"
          word units -> ["Could", "you", "wake", "me", "up", "at", "o'clock"]
          index:            0       1      2      3     4     5        6
          The digit "6" is skipped completely — it is NOT index 6 and does NOT
          push "o'clock" to index 7. "o'clock" is index 6, right after "at" (5).
          A hyphenated word like "well-known" behaves the same way: the hyphen
          is skipped, so it becomes TWO word units ("well" then "known"), each
          with its own index.

        Full example item:
        {
          "ko": "탑승구가 어디인가요?",
          "answer": "Where is the boarding gate?",
          "keyKo": "탑승구",
          "blanks": [{ "at": 3, "word": "boarding" }],
          "source": "Airport 101"
        }

        Rules:
        - Output a valid JSON array of [NUMBER] such objects, nothing else.
        - Every "answer" must be grammatically correct, natural English.
        - Vary sentence structure across items; don't reuse the same pattern.
        - "word" must never include trailing/leading punctuation.
        - Recount every "at" by hand against the rule above before outputting,
          paying special attention to any sentence containing a number,
          hyphenated word, or symbol — that's the most common mistake.

        CONTENT:
        [PASTE YOUR SOURCE TEXT, ARTICLE, WORD LIST, OR TOPIC HERE]
      .row
        button#copyAiPromptBtn(type="button") Copy prompt
        span#copyAiPromptStatus.copy-status

    details
      summary Advanced: bulk add via JSON
      label(for="bulkItems") Paste a JSON array of new items — merged onto the list above, your existing items are kept
      textarea#bulkItems(placeholder='[{"ko": "...", "answer": "..."}]')
      #bulkItemsError.error(hidden)
      button#mergeBulkBtn(type="button") Merge into list

    details(open=(p.itemsRaw !== undefined))
      summary Advanced: edit raw JSON directly
      label(for="items") Items (JSON array — see docs/13.community_content_formats.md in LangDrillApp for the schema per type)
      textarea#items(name="items")= itemsJson

    button(type="submit")= submitLabel || 'Save'
