mixin icon(name, size)
  svg.icon(viewBox="0 0 24 24" width=(size || 20) height=(size || 20) fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")!= ICON_PATHS[name] || ''

//- The brand mark: a speech bubble with a spark, in the brand gradient.
mixin brandMark(size)
  svg.brand-mark(viewBox="0 0 32 32" width=(size || 30) height=(size || 30) aria-hidden="true" focusable="false")
    defs
      linearGradient#bm-grad(x1="0" y1="0" x2="1" y2="1")
        stop(offset="0" stop-color="#8b7cf6")
        stop(offset="1" stop-color="#e2a74f")
    rect(x="1" y="1" width="30" height="30" rx="9" fill="url(#bm-grad)")
    path(d="M9 10.5h14a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-7l-4.5 3.5V20.5H9a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2Z" fill="#fff" fill-opacity="0.95")
    path(d="M16 12.6c.3 1.7 1.2 2.6 2.9 2.9-1.7.3-2.6 1.2-2.9 2.9-.3-1.7-1.2-2.6-2.9-2.9 1.7-.3 2.6-1.2 2.9-2.9Z" fill="#6d5ce8")
