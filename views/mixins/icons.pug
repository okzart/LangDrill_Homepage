mixin icon(name, size)
  svg.icon(viewBox="0 0 24 24" width=(size || 20) height=(size || 20) fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")!= ICON_PATHS[name] || ''

//- The brand mark: a speech bubble with a spark on the accent square
//- (reference_designs/LanguageDrill Home.html).
mixin brandMark(size)
  svg.brand-mark(viewBox="0 0 32 32" width=(size || 30) height=(size || 30) aria-hidden="true" focusable="false")
    rect(x="0" y="0" width="32" height="32" rx="7" fill="#5980a6")
    path(d="M8.4 8.6h15.2a2.4 2.4 0 0 1 2.4 2.4v7.6a2.4 2.4 0 0 1-2.4 2.4h-7.2l-4.6 3.8v-3.8H8.4A2.4 2.4 0 0 1 6 18.6V11a2.4 2.4 0 0 1 2.4-2.4Z" fill="#f2f2f3")
    path(d="M16 10.9l1.1 2.6 2.6 1.1-2.6 1.1-1.1 2.6-1.1-2.6-2.6-1.1 2.6-1.1Z" fill="#5980a6")
