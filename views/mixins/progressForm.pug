//- Shared by views/progress.pug (self-service) and
//- views/admin/userProgress.pug (admin editing another user's record) -
//- same field set as ProgressStats' own admin.pug NUMERIC_FIELD_CONFIG,
//- kept in sync server-side by src/services/progressForm.js. `progress`
//- is the current record (from GET .../me or .../admin/users/:id);
//- `actionUrl` is where the form POSTs.
mixin numberField(key, label, min, max, step)
  div
    label(for=key)= label
    input(id=key type="number" name=key min=min max=max step=(step || '1') value=progress[key])

mixin progressForm(progress, actionUrl)
  form(method="POST" action=actionUrl)
    h2 Gamification & stats
    .grid
      +numberField('xp', 'XP', 0)
      +numberField('level', 'Level', 1)
      +numberField('streakDays', 'Streak days', 0)
      +numberField('longestStreak', 'Longest streak', 0)
      +numberField('totalSentences', 'Total sentences', 0)
      +numberField('totalStudyTime', 'Total study time', 0, undefined, 'any')
      +numberField('averageAccuracy', 'Avg. accuracy (%)', 0, 100)
      +numberField('savedItemsCount', 'Saved items', 0)
      +numberField('foldersCount', 'Folders', 0)
      +numberField('dailyGoal', 'Daily goal', 0)
      +numberField('dailyGoalProgress', 'Daily goal progress', 0)

    h2 Accuracy by drill type (%)
    .grid
      +numberField('vocabAccuracy', 'Vocab', 0, 100)
      +numberField('listeningAccuracy', 'Listening', 0, 100)
      +numberField('writingAccuracy', 'Writing', 0, 100)
      +numberField('youtubeAccuracy', 'YouTube', 0, 100)

    h2 Other
    label(for="badges") Badges (comma-separated)
    input#badges(type="text" name="badges" value=(progress.badges || []).join(', '))
    label(for="targetLanguage") Target language
    input#targetLanguage(type="text" name="targetLanguage" value=progress.targetLanguage)
    label(for="lastStudyDate") Last study date
    - var lastStudyLocal = progress.lastStudyDate ? new Date(progress.lastStudyDate).toISOString().slice(0, 16) : ''
    input#lastStudyDate(type="datetime-local" name="lastStudyDate" value=lastStudyLocal)
    label Weekly activity (Mon–Sun)
    .grid
      each day, i in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
        div
          label(for=`weekly-${i}`)= day
          input(id=`weekly-${i}` type="number" name="weeklyActivity[]" min="0" step="1" value=(progress.weeklyActivity || [])[i] || 0)

    button(type="submit") Save
