//- Admin: one user's progress - the same dashboard as /progress
//- (views/mixins/progressCharts.pug) above the edit form
//- (views/mixins/progressForm.pug). The charts redraw live from the form as
//- values are edited; nothing is stored until Save.
doctype html
html(lang=lang || "en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= 'LanguageDrill — ' + t('Admin: User Progress')
    include ../_style
  body
    include ../_nav
    include ../mixins/progressCharts
    include ../mixins/progressForm
    h1= t('Progress for {user}', { user: userId })

    if error
      .error= t(error)
    if saved
      .success= t('Saved.')

    +progressCharts(progress, { liveForm: '#progress-form', previewNote: t('Preview: the charts update as you edit the fields below. Nothing is stored until you press Save.') })

    section
      h2= t('Edit')
      +progressForm(progress, `/admin/users/${userId}/progress`)

    form(method="POST" action=`/admin/users/${userId}/progress/delete`)
      button.danger(type="submit")= t('Delete this progress record')

    p
      a(href="/admin/users")= t('← Back to Users')
