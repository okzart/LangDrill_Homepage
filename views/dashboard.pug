//- Home, following reference_designs/LanguageDrill Home.html: shortcuts on
//- the left; in the middle a stories row of quick actions, a navy greeting
//- header joined to the "what do you want to practise?" composer, then the
//- community feed (drill sets as posts) with a segmented type filter; on the
//- right a navy-headed progress widget, trending sets and top creators.
//- Data from src/routes/dashboardRoutes.js#showDashboard.
doctype html
html(lang=lang || "en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= 'LanguageDrill — ' + t('Home')
    include _style
    style.
      .home { display: grid; grid-template-columns: 212px minmax(0, 690px) 300px; justify-content: center; gap: 27px; align-items: start; }
      .rail { position: sticky; top: 84px; display: grid; gap: 20px; }
      @media (max-width: 1260px) { .home { grid-template-columns: minmax(0, 690px) 300px; gap: 22px; } .rail-left { display: none; } }
      @media (max-width: 960px) { .home { grid-template-columns: minmax(0, 690px); } .rail-right { position: static; order: 2; } }

      /* left rail */
      .me-link { display: flex; align-items: center; gap: 10px; padding: 6px 8px; margin-bottom: 14px; color: var(--text); text-decoration: none; }
      .me-link .who { display: grid; min-width: 0; line-height: 1.35; }
      .me-link strong { font-size: 15px; font-weight: 600; }
      .me-link small { font-size: 12px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .shortcuts { display: grid; gap: 2px; }
      .shortcuts a { display: flex; align-items: center; gap: 12px; padding: 6px 8px; border-radius: 12px; color: var(--text); font-size: 15px; font-weight: 500; text-decoration: none; }
      .shortcuts a:hover { background: rgba(65, 97, 128, 0.08); }
      .shortcuts .ico { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; color: var(--n-100); flex: none; }
      .shortcuts .kicker { margin: 18px 8px 6px; }
      .rail-foot { margin: 20px 8px 0; font-size: 12px; color: var(--muted); }

      /* stories */
      .stories { display: flex; gap: 8px; overflow-x: auto; padding: 14px 16px 12px; margin-bottom: 20px; background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow-sm); scrollbar-width: none; }
      .stories::-webkit-scrollbar { display: none; }
      .story { flex: none; display: flex; flex-direction: column; align-items: center; gap: 7px; width: 76px; color: var(--text); text-decoration: none; font-size: 12.5px; font-weight: 500; line-height: 1.25; text-align: center; }
      .story .ring { position: relative; display: block; width: 66px; height: 66px; padding: 2.5px; border-radius: 50%; background: var(--brand); transition: transform 0.2s; }
      .story:hover .ring { transform: scale(1.05); }
      .story .gap { display: block; width: 100%; height: 100%; padding: 3px; border-radius: 50%; background: var(--n-100); }
      .story .disc { display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; color: var(--n-100); }
      .story .badge { position: absolute; right: -2px; bottom: -2px; display: grid; place-items: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--blue-900); color: var(--n-100); border: 2px solid var(--n-100); font-family: var(--display); font-size: 13px; font-weight: 600; }

      /* greeting header + composer */
      .welcome { padding: 0; overflow: hidden; margin-bottom: 26px; }
      .welcome .band { display: flex; align-items: flex-end; justify-content: space-between; gap: 13.6px; flex-wrap: wrap; padding: 20.4px 20.4px 16px; background: var(--blue-900); color: var(--n-100); }
      .welcome .date { font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue-300); }
      .welcome h2 { margin: 4px 0 0; font-size: 34px; color: var(--n-100); }
      .welcome .streak { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: var(--blue-800); color: var(--n-100); font-size: 13px; font-weight: 500; text-decoration: none; }
      .welcome .streak:hover { background: var(--blue-700); color: var(--n-100); }
      .welcome .compose { display: flex; align-items: center; gap: 13.6px; padding: 13.6px 13.6px 0; }
      .welcome .fake-input { flex: 1; display: flex; align-items: center; min-height: 44px; padding: 8px 18px; border-radius: 999px; background: var(--chip); color: var(--n-800); text-decoration: none; }
      .welcome .fake-input:hover { background: var(--chip-hover); color: var(--text); }
      .welcome .actions { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 13.6px; }
      .welcome .actions a { display: flex; align-items: center; justify-content: center; gap: 8px; height: 42px; border-radius: 999px; background: var(--blue-100); color: var(--text); font-family: var(--display); font-size: 15px; font-weight: 600; text-decoration: none; }
      .welcome .actions a:hover { background: var(--blue-200); }
      @media (max-width: 560px) { .welcome .actions { grid-template-columns: repeat(2, 1fr); } .welcome h2 { font-size: 28px; } }

      /* feed header + segmented filter */
      .feed-head { display: flex; align-items: center; justify-content: space-between; gap: 10.2px; flex-wrap: wrap; margin-bottom: 16px; }
      .feed-head h2 { margin: 0; font-size: 26px; }
      .segment { display: inline-flex; overflow: hidden; background: var(--n-100); border: 1px solid var(--line); border-radius: 999px; box-shadow: var(--shadow-sm); }
      .segment a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 13px; font-size: 14px; font-weight: 500; color: var(--text); text-decoration: none; }
      .segment a + a { border-left: 1px solid var(--line); }
      .segment a.on { background: var(--accent); color: var(--n-100); }
      .segment a:not(.on):hover { background: rgba(29, 31, 32, 0.07); }
      .segment a span { font-size: 12px; opacity: 0.75; }

      /* posts */
      .post { display: flex; flex-direction: column; margin-bottom: 20px; background: var(--surface); border-top: 4px solid var(--blue-800); border-radius: var(--radius); box-shadow: var(--shadow); }
      .post-listening { border-top-color: var(--blue-500); }
      .post-writing { border-top-color: var(--n-600); }
      .post-head { display: flex; align-items: center; gap: 10.2px; padding: 13.6px 13.6px 0; }
      .post-head .who { flex: 1; min-width: 0; line-height: 1.3; }
      .post-head .name { font-size: 15px; font-weight: 600; }
      .post-head .sub { font-size: 13px; color: var(--muted); }
      .type-pill { flex: none; display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; font-size: 11px; letter-spacing: 0.02em; }
      .type-vocab { background: var(--blue-100); color: var(--blue-800); }
      .type-writing { background: var(--n-100); color: var(--n-800); }
      .type-listening { background: none; color: var(--blue-700); box-shadow: inset 0 0 0 1px var(--blue-600); }
      .post-body { padding: 10px 13.6px 13.6px; }
      a.post-title { display: block; margin: 0 0 4px; font-family: var(--display); font-size: 24px; font-weight: 600; line-height: 1.12; letter-spacing: -0.015em; color: var(--text); text-decoration: none; }
      a.post-title:hover { color: var(--blue-700); }
      .post-desc { margin: 0 0 8px; font-size: 14.5px; color: var(--n-800); }
      .post-items { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 2px; }
      .post-items li { display: flex; align-items: center; gap: 10.2px; padding: 10px 12px; border-radius: 12px; transition: background 0.15s; }
      .post-items li:hover { background: rgba(65, 97, 128, 0.06); }
      .post-items .txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
      .post-items .en { font-size: 16px; font-weight: 500; line-height: 1.5; color: var(--text); }
      .post-items .ko { font-size: 13.5px; color: var(--muted); }
      .post-items .ko.arrow::before { content: "→ "; color: var(--blue-700); }
      .post-items .play { flex: none; width: 36px; height: 36px; min-height: 0; margin: 0; padding: 0; border: 0; border-radius: 50%; background: var(--blue-100); color: var(--blue-800); }
      .post-items .play:hover { background: var(--blue-200); color: var(--blue-800); }
      .post-items .play.playing { background: var(--blue-700); color: var(--n-100); }
      .post-items .play-ico { font-size: 11px; margin-left: 2px; }
      .post-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 10px 0 12px; font-size: 13px; color: var(--muted); }
      .post-foot a.more { font-weight: 500; color: var(--blue-700); }
      .post-foot .stats { display: inline-flex; align-items: center; gap: 5px; }
      .post-foot .dot { margin: 0 4px; }
      .post-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
      .post-actions form { display: contents; }
      .post-actions .act { display: flex; align-items: center; justify-content: center; gap: 8px; height: 42px; min-height: 0; margin: 0; padding: 0 6px; border: 0; border-radius: 999px; background: var(--blue-100); color: var(--text); font-family: var(--display); font-size: 15px; font-weight: 600; text-decoration: none; }
      .post-actions .act:hover { background: var(--blue-200); color: var(--text); }
      .post-actions .act.primary { background: var(--accent); color: var(--n-100); }
      .post-actions .act.primary:hover { background: var(--blue-600); color: var(--n-100); }
      #load-more { width: 100%; min-height: 46px; margin: 0 0 1rem; background: var(--n-100); border-color: var(--line); color: var(--text); }
      #load-more:hover { background: rgba(29, 31, 32, 0.07); }
      .feed-empty { text-align: center; padding: 34px 22px; }
      .feed-empty p { color: var(--muted); }

      /* right rail */
      .widget { padding: 13.6px; margin: 0; }
      .widget-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 0 0 6.8px; }
      .widget-head h4 { margin: 0; font-size: 20px; }
      .widget-head .icon { color: var(--blue-700); }
      .widget.progress .widget-head { margin: -13.6px -13.6px 10.2px; padding: 10.2px 13.6px; background: var(--blue-900); border-radius: var(--radius) var(--radius) 0 0; }
      .widget.progress .widget-head h4 { color: var(--n-100); }
      .widget.progress .widget-head a { font-size: 13px; font-weight: 500; color: var(--blue-300); }
      .stats3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; text-align: center; }
      .stats3 > div { padding: 10px 6px; border-radius: 12px; background: var(--blue-100); }
      .stats3 .v { display: inline-flex; align-items: center; gap: 2px; font-family: var(--display); font-size: 28px; font-weight: 600; line-height: 1; }
      .stats3 .k { font-size: 12px; color: var(--muted); margin-top: 4px; }
      .goal { margin-top: 13.6px; }
      .goal .line { display: flex; justify-content: space-between; font-size: 13px; }
      .goal .line b { font-family: var(--display); font-size: 15px; font-weight: 600; }
      .goal .bar { height: 8px; margin-top: 6px; border-radius: 999px; background: var(--blue-200); overflow: hidden; }
      .goal .bar div { height: 100%; border-radius: 999px; background: var(--blue-700); }
      .goal .left { margin-top: 6px; font-size: 12px; color: var(--muted); }
      .rank { list-style: none; margin: 0; padding: 0; display: grid; }
      .rank li a { display: flex; align-items: center; gap: 10.2px; padding: 7px 4px; border-radius: 10px; color: var(--text); text-decoration: none; }
      .rank li a:hover { background: rgba(65, 97, 128, 0.07); }
      .rank .n { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; font-family: var(--display); font-size: 14px; font-weight: 600; }
      .rank li:first-child .n { background: var(--accent); color: var(--n-100); }
      .rank .t { flex: 1; min-width: 0; display: grid; line-height: 1.3; }
      .rank .t b { font-size: 15px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .rank .t small { font-size: 12px; color: var(--muted); }
      .toast { position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%); padding: 8px 16px; border-radius: 999px; background: var(--blue-900); color: var(--n-100); font-size: 14px; font-weight: 500; box-shadow: var(--shadow-lg); z-index: 80; }
      .toast[hidden] { display: none; }
  body.wide
    include _nav
    include mixins/feed

    - var me = currentUser.email || ''
    - var meName = me.split('@')[0]
    - var streak = progress ? Number(progress.streakDays) || 0 : 0
    - var goal = progress ? Number(progress.dailyGoal) || 0 : 0
    - var done = progress ? Number(progress.dailyGoalProgress) || 0 : 0
    .home
      //- ---- left: profile + shortcuts ----
      aside.rail.rail-left(aria-label=t('Shortcuts'))
        div
          a.me-link(href="/profile")
            +avatar(me, 42)
            span.who
              strong= meName
              small= me
          nav.shortcuts(aria-label=t('Shortcuts'))
            a(href="/progress")
              span.ico.tone-1
                +icon('chart', 18)
              = t('Progress')
            a(href="/community")
              span.ico.tone-2
                +icon('users', 18)
              = t('Community')
            a(href="/chat")
              span.ico.tone-3
                +icon('chat', 18)
              = t('Chat')
            a(href="/passages")
              span.ico.tone-4
                +icon('book', 18)
              = t('Passages')
            a(href="/studio")
              span.ico.tone-5
                +icon('studio', 18)
              = t('Studio')
            a(href="/scan")
              span.ico.tone-3
                +icon('scan', 18)
              = t('Scan & Study')
            a(href="/transcribe")
              span.ico.tone-2
                +icon('captions', 18)
              = t('Subtitles')
            if currentUser.role === 'admin'
              span.kicker= t('Administration')
              a(href="/admin/users")
                span.ico.tone-5
                  +icon('shield', 18)
                = t('Users & progress')
              a(href="/admin/audio")
                span.ico.tone-5
                  +icon('volume', 18)
                = t('Vocab audio')
              a(href="/admin/listening")
                span.ico.tone-5
                  +icon('headphones', 18)
                = t('Listening (Dia2)')
          p.rail-foot LanguageDrill · #{new Date().getFullYear()}

      //- ---- middle: stories, greeting + composer, feed ----
      main.feed-col
        -
          var stories = [
            { href: '/chat', icon: 'sparkle', tone: 'tone-1', label: t('AI tutor') },
            { href: '/studio', icon: 'studio', tone: 'tone-2', label: t('Make a drill') },
            { href: '/scan', icon: 'scan', tone: 'tone-4', label: t('Scan a page') },
            { href: '/transcribe', icon: 'captions', tone: 'tone-1', label: t('Subtitle a video') },
            { href: '/community?tab=create', icon: 'plus', tone: 'tone-3', label: t('Publish a set') },
            { href: '/passages', icon: 'book', tone: 'tone-5', label: t('Passage') },
            { href: '/progress', icon: 'flame', tone: 'tone-1', label: t('My streak'), badge: streak },
            { href: '/community?type=listening', icon: 'headphones', tone: 'tone-3', label: t('Listening sets') },
            { href: '/community?type=vocab', icon: 'type', tone: 'tone-4', label: t('Vocab sets') },
          ];
        .stories(aria-label=t('Quick actions'))
          each s in stories
            a.story(href=s.href)
              span.ring
                span.gap
                  span.disc(class=s.tone)
                    +icon(s.icon, 24)
                if s.badge
                  span.badge= s.badge
              span= s.label

        section.welcome
          .band
            div
              .date#today= new Date().toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-GB', { weekday: 'long', day: 'numeric', month: 'long' })
              h2#greeting(data-name=meName)= t('Welcome back') + ', ' + meName
            if progress
              a.streak(href="/progress")
                +icon('flame', 15)
                = t('{n}-day streak · {done}/{goal} today', { n: streak, done: done, goal: goal })
          .compose
            +avatar(me, 42)
            a.fake-input(href="/chat")= t('What do you want to practise today?')
          .actions
            a(href="/chat")
              +icon('chat', 18)
              = t('Chat')
            a(href="/studio")
              +icon('studio', 18)
              = t('Studio')
            a(href="/community?tab=create")
              +icon('plus', 18)
              = t('Publish')
            a(href="/passages")
              +icon('book', 18)
              = t('Passages')

        .feed-head
          h2= t('Community feed')
          - var tabs = [['', t('All'), counts.all], ['vocab', t('Vocab'), counts.vocab], ['listening', t('Listening'), counts.listening], ['writing', t('Writing'), counts.writing]]
          nav.segment(aria-label=t('Filter the feed'))
            each tb in tabs
              a(href=tb[0] ? `/dashboard?type=${tb[0]}` : '/dashboard' class=type === tb[0] ? 'on' : '' aria-current=(type === tb[0] ? 'true' : false))
                = tb[1]
                span= tb[2]

        if feedError
          .error= t(feedError)
        #feed(data-type=type)
          each post in posts
            +feedPost(post)
        if !posts.length && !feedError
          section.feed-empty
            h2= t('No sets here yet')
            p= t('Be the first to share one - make a listening drill in Studio or publish a set.')
            a.btn(href="/community?tab=create")
              +icon('plus', 17)
              = t('Publish a set')
        if hasMore
          button#load-more(type="button" data-offset=nextOffset data-type=type)= t('Load more')

      //- ---- right: progress, trending, creators ----
      aside.rail.rail-right
        section.widget.progress
          .widget-head
            h4= t('Your progress')
            a(href="/progress")= t('See all')
          if progress
            .stats3
              div
                .v
                  +icon('flame', 18)
                  = streak
                .k= t('day streak')
              div
                .v= progress.xp || 0
                .k XP
              div
                .v= progress.level || 1
                .k= t('Level')
            .goal
              .line
                span= t('Daily goal')
                b= goal > 0 ? `${done} / ${goal}` : '—'
              .bar(role="meter" aria-label=t('Daily goal progress') aria-valuemin="0" aria-valuemax=goal aria-valuenow=done)
                div(style=`width:${goal > 0 ? Math.min(100, done / goal * 100) : 0}%`)
              .left= goal <= 0 ? t('No daily goal set') : done >= goal ? t('✓ Goal reached') : t('{n} to go · {pct}%', { n: goal - done, pct: Math.round(done / goal * 100) })
          else
            p.hint= t('Progress is unavailable right now.')
        if trending.length
          section.widget
            .widget-head
              h4= t('Trending sets')
              +icon('trend', 18)
            ol.rank
              each c, i in trending
                li
                  a(href=`/community/${encodeURIComponent(c.id)}`)
                    span.n= i + 1
                    span.t
                      b= c.name
                      small= c.downloads === 1 ? t('{type} · {n} download', { type: t(c.type), n: 1 }) : t('{type} · {n} downloads', { type: t(c.type), n: c.downloads })
        if creators.length
          section.widget
            .widget-head
              h4= t('Top creators')
              +icon('trophy', 18)
            ul.rank
              each c in creators
                li
                  a(href=`/community?q=${encodeURIComponent(c.author)}`)
                    +avatar(c.author, 34)
                    span.t
                      b= c.author
                      small= t(c.sets === 1 ? '1 set' : '{n} sets', { n: c.sets }) + ' · ' + t(c.downloads === 1 ? '1 download' : '{d} downloads', { d: c.downloads })

    #toast.toast(hidden role="status" aria-live="polite")

    script.
      (function () {
        // Date and time-of-day greeting in the viewer's own time zone.
        var now = new Date();
        var today = document.getElementById('today');
        today.textContent = now.toLocaleDateString(LD_LANG === 'ko' ? 'ko-KR' : 'en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
        var g = document.getElementById('greeting');
        var h = now.getHours();
        var key = h < 5 ? 'Good evening' : h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
        g.textContent = t('{greeting}, {name}', { greeting: t(key), name: g.dataset.name });

        var toast = document.getElementById('toast'), toastTimer = null;
        function say(text) {
          toast.textContent = text;
          toast.hidden = false;
          clearTimeout(toastTimer);
          toastTimer = setTimeout(function () { toast.hidden = true; }, 2200);
        }

        // One shared player for every ▶ in the feed.
        var player = new Audio(), playingBtn = null;
        player.addEventListener('ended', function () { if (playingBtn) playingBtn.classList.remove('playing'); playingBtn = null; });
        document.addEventListener('click', function (e) {
          var play = e.target.closest('.post-items .play');
          if (play) {
            if (playingBtn === play && !player.paused) { player.pause(); play.classList.remove('playing'); playingBtn = null; return; }
            if (playingBtn) playingBtn.classList.remove('playing');
            player.src = play.dataset.src;
            player.play().catch(function () { say(t('Could not play this clip.')); });
            play.classList.add('playing');
            playingBtn = play;
            return;
          }
          var share = e.target.closest('.share');
          if (share) {
            var url = location.origin + share.dataset.url;
            var copied = function () { say(t('Link copied')); };
            if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(url).then(copied, function () { window.prompt(t('Copy this link'), url); });
            else window.prompt(t('Copy this link'), url);
          }
        });

        // Load more: append the next page of posts (server-rendered fragment).
        var more = document.getElementById('load-more');
        if (more) more.addEventListener('click', function () {
          more.disabled = true;
          more.textContent = t('Loading…');
          var qs = 'offset=' + encodeURIComponent(more.dataset.offset) + (more.dataset.type ? '&type=' + encodeURIComponent(more.dataset.type) : '');
          fetch('/feed?' + qs).then(function (res) {
            if (res.redirected) { location.href = '/login?next=/dashboard'; return null; }
            if (!res.ok) throw new Error('HTTP ' + res.status);
            var hasMore = res.headers.get('X-Has-More') === '1';
            var next = res.headers.get('X-Next-Offset');
            return res.text().then(function (html) {
              document.getElementById('feed').insertAdjacentHTML('beforeend', html);
              if (hasMore) { more.dataset.offset = next; more.disabled = false; more.textContent = t('Load more'); }
              else more.remove();
            });
          }).catch(function () { more.disabled = false; more.textContent = t('Load more'); say(t('Could not load more posts.')); });
        });
      })();
