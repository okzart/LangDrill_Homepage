//- Home, laid out like a social network: shortcuts on the left, the feed in
//- the middle (stories row of quick actions, a "what do you want to
//- practise?" composer, then community drill sets as posts), and your
//- progress / trending sets / top creators on the right. Data from
//- src/routes/dashboardRoutes.js#showDashboard.
doctype html
html(lang=lang || "en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= 'LanguageDrill — ' + t('Home')
    include _style
    style.
      .home { display: grid; grid-template-columns: 250px minmax(0, 620px) 300px; justify-content: center; gap: 1.5rem; align-items: start; }
      .rail { position: sticky; top: 76px; display: grid; gap: 1rem; }
      @media (max-width: 1180px) { .home { grid-template-columns: minmax(0, 620px) 300px; } .rail-left { display: none; } }
      @media (max-width: 900px) { .home { grid-template-columns: minmax(0, 620px); } .rail-right { position: static; order: 2; } }

      /* left rail: profile + shortcuts */
      .shortcuts { display: grid; gap: 0.1rem; }
      .shortcuts a { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.6rem; border-radius: 10px; color: var(--ink); font-weight: 600; text-decoration: none; }
      .shortcuts a:hover { background: var(--chip-hover); }
      .shortcuts .ico { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; color: #fff; }
      .shortcuts h4 { margin: 0.9rem 0.6rem 0.3rem; font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
      .shortcuts .me-link .who { display: grid; line-height: 1.25; min-width: 0; }
      .shortcuts .me-link small { color: var(--muted); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .rail-foot { padding: 0 0.6rem; font-size: 0.75rem; color: var(--faint); }

      /* stories */
      .stories { display: flex; gap: 0.55rem; overflow-x: auto; padding: 0.9rem 1rem; margin-bottom: 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; scrollbar-width: none; }
      .stories::-webkit-scrollbar { display: none; }
      .story { flex: none; display: grid; justify-items: center; gap: 0.35rem; width: 72px; color: var(--ink); text-decoration: none; font-size: 0.74rem; font-weight: 600; text-align: center; line-height: 1.2; }
      .story .ring { padding: 3px; border-radius: 50%; background: conic-gradient(from 200deg, #f1b45b, #e6566f, #8b5cf6, #6d5ce8, #f1b45b); transition: transform 0.2s; }
      .story:hover .ring { transform: scale(1.05); }
      .story .disc { display: grid; place-items: center; width: 62px; height: 62px; border-radius: 50%; border: 3px solid var(--surface); color: #fff; }

      /* composer */
      .composer { display: grid; gap: 0.75rem; padding: 0.9rem 1rem; margin-bottom: 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow-sm); }
      .composer .top { display: flex; gap: 0.75rem; align-items: center; }
      .composer .fake-input { flex: 1; display: flex; align-items: center; min-height: 44px; padding: 0 1.1rem; border-radius: 999px; background: var(--chip); color: var(--muted); text-decoration: none; transition: background 0.15s; }
      .composer .fake-input:hover { background: var(--chip-hover); color: var(--ink); }
      .composer .actions { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.25rem; padding-top: 0.6rem; border-top: 1px solid var(--line); }
      .composer .actions a { display: flex; align-items: center; justify-content: center; gap: 0.45rem; padding: 0.55rem 0.4rem; border-radius: 10px; color: var(--ink-2); font-weight: 600; font-size: 0.85rem; text-decoration: none; text-align: center; }
      .composer .actions a:hover { background: var(--chip); }
      @media (max-width: 560px) { .composer .actions { grid-template-columns: repeat(2, 1fr); } }

      /* feed filter */
      .feed-tabs { display: flex; gap: 0.4rem; margin: 0 0 0.85rem; overflow-x: auto; scrollbar-width: none; }
      .feed-tabs a { flex: none; padding: 0.42rem 0.95rem; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); color: var(--ink-2); font-weight: 600; font-size: 0.85rem; text-decoration: none; }
      .feed-tabs a.active { background: var(--ink); border-color: var(--ink); color: #fff; }
      .feed-tabs a span { opacity: 0.6; margin-left: 0.25rem; font-weight: 500; }

      /* posts */
      .post { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow-sm); margin-bottom: 1rem; padding: 1rem 1.1rem 0.35rem; }
      .post-head { display: flex; align-items: center; gap: 0.7rem; }
      .post-head .who { flex: 1; min-width: 0; line-height: 1.3; }
      .post-head .name { font-weight: 700; color: var(--ink); }
      .post-head .sub { font-size: 0.8rem; color: var(--muted); }
      .type-pill { flex: none; padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; }
      .type-vocab { background: #e8f1fd; color: #2a63c9; }
      .type-listening { background: var(--violet-soft); color: var(--violet); }
      .type-writing { background: var(--gold-soft); color: #94621a; }
      a.post-title { display: block; margin: 0.8rem 0 0.2rem; font-size: 1.12rem; font-weight: 750; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
      a.post-title:hover { text-decoration: underline; }
      .post-desc { margin: 0.2rem 0 0.4rem; color: var(--text); }
      .post-items { list-style: none; margin: 0.7rem 0 0; padding: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
      .post-items li { position: relative; display: grid; gap: 0.1rem; padding: 0.65rem 3rem 0.65rem 0.9rem; background: var(--surface-2); }
      .post-items li + li { border-top: 1px solid var(--line); }
      .post-items .en { color: var(--ink); font-weight: 500; }
      .post-items .ko { color: var(--muted); font-size: 0.86rem; }
      .post-items .play { position: absolute; right: 0.6rem; top: 50%; transform: translateY(-50%); width: 34px; height: 34px; margin: 0; padding: 0; border-radius: 50%; background: var(--surface); }
      .post-items .play:active { transform: translateY(-50%); }
      .post-items .play.playing { background: var(--violet); color: #fff; border-color: var(--violet); }
      .post-items .play-ico { font-size: 0.7rem; margin-left: 2px; }
      a.more { display: inline-block; margin-top: 0.5rem; font-size: 0.85rem; font-weight: 600; }
      .post-stats { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.75rem; padding-bottom: 0.55rem; font-size: 0.8rem; color: var(--muted); border-bottom: 1px solid var(--line); }
      .post-stats span { display: inline-flex; align-items: center; gap: 0.3rem; }
      .post-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.25rem; padding: 0.3rem 0; }
      .post-actions form { display: contents; }
      .post-actions .act { display: flex; align-items: center; justify-content: center; gap: 0.45rem; margin: 0; padding: 0.55rem; border: 0; border-radius: 10px; background: none; box-shadow: none; color: var(--ink-2); font-weight: 600; font-size: 0.88rem; text-decoration: none; transform: none; }
      .post-actions .act:hover { background: var(--chip); color: var(--ink); box-shadow: none; transform: none; }
      #load-more { width: 100%; margin: 0 0 1rem; padding: 0.75rem; }
      .feed-empty { text-align: center; padding: 2.2rem 1.4rem; }
      .feed-empty p { color: var(--muted); }

      /* right rail widgets */
      .widget { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 1rem 1.05rem; box-shadow: var(--shadow-sm); }
      .widget h3 { display: flex; align-items: center; justify-content: space-between; margin: 0 0 0.75rem; font-size: 0.98rem; }
      .widget h3 a { font-size: 0.8rem; font-weight: 600; }
      .stats3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; text-align: center; }
      .stats3 .v { font-size: 1.35rem; font-weight: 800; color: var(--ink); line-height: 1.1; }
      .stats3 .k { font-size: 0.72rem; color: var(--muted); }
      .stats3 .flame { color: #e6566f; }
      .goal { margin-top: 0.9rem; }
      .goal .row { justify-content: space-between; font-size: 0.8rem; color: var(--muted); }
      .goal .bar { height: 8px; margin-top: 0.35rem; border-radius: 999px; background: var(--violet-soft); overflow: hidden; }
      .goal .bar div { height: 100%; border-radius: 999px; background: var(--brand); }
      .rank { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
      .rank li a { display: flex; align-items: center; gap: 0.65rem; padding: 0.4rem 0.35rem; border-radius: 10px; color: var(--ink); text-decoration: none; }
      .rank li a:hover { background: var(--chip); }
      .rank .n { flex: none; width: 1.4rem; text-align: center; font-weight: 800; color: var(--faint); }
      .rank li:nth-child(1) .n { color: #e2a74f; }
      .rank .t { flex: 1; min-width: 0; display: grid; line-height: 1.3; }
      .rank .t b { font-weight: 650; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .rank .t small { color: var(--muted); font-size: 0.75rem; }
      .toast { position: fixed; left: 50%; bottom: 92px; transform: translateX(-50%); padding: 0.6rem 1rem; border-radius: 999px; background: var(--ink); color: #fff; font-size: 0.85rem; font-weight: 600; box-shadow: var(--shadow-lg); z-index: 80; }
      .toast[hidden] { display: none; }
  body.wide
    include _nav
    include mixins/feed

    - var me = currentUser.email || ''
    - var meName = me.split('@')[0]
    .home
      //- ---- left: profile + shortcuts ----
      aside.rail.rail-left(aria-label=t('Shortcuts'))
        nav.shortcuts(aria-label=t('Shortcuts'))
          a.me-link(href="/profile")
            +avatar(me, 36)
            span.who
              span= meName
              small= me
          a(href="/progress")
            span.ico.tone-blue
              +icon('chart', 19)
            = t('Progress')
          a(href="/community")
            span.ico.tone-teal
              +icon('users', 19)
            = t('Community')
          a(href="/chat")
            span.ico.tone-violet
              +icon('chat', 19)
            = t('Chat')
          a(href="/passages")
            span.ico.tone-gold
              +icon('book', 19)
            = t('Passages')
          a(href="/studio")
            span.ico.tone-rose
              +icon('studio', 19)
            = t('Studio')
          if currentUser.role === 'admin'
            h4= t('Administration')
            a(href="/admin/users")
              span.ico.tone-ink
                +icon('shield', 19)
              = t('Users')
            a(href="/admin/audio")
              span.ico.tone-gold
                +icon('volume', 19)
              = t('Vocab audio')
            a(href="/admin/listening")
              span.ico.tone-violet
                +icon('headphones', 19)
              = t('Listening (Dia2)')
        p.rail-foot LanguageDrill · #{new Date().getFullYear()}

      //- ---- middle: stories, composer, feed ----
      main.feed-col
        -
          var stories = [
            { href: '/chat', icon: 'chat', tone: 'tone-violet', label: t('AI tutor') },
            { href: '/studio', icon: 'studio', tone: 'tone-rose', label: t('Make a drill') },
            { href: '/community?tab=create', icon: 'plus', tone: 'tone-teal', label: t('Publish') },
            { href: '/passages', icon: 'book', tone: 'tone-gold', label: t('Passage') },
            { href: '/progress', icon: 'flame', tone: 'tone-ink', label: t('My streak') },
            { href: '/community?type=listening', icon: 'headphones', tone: 'tone-blue', label: t('Listening') },
            { href: '/community?type=vocab', icon: 'users', tone: 'tone-violet', label: t('Vocab sets') },
          ];
        .stories(aria-label=t('Quick actions'))
          each s in stories
            a.story(href=s.href)
              span.ring
                span.disc(class=s.tone)
                  +icon(s.icon, 26)
              span= s.label

        .composer
          .top
            +avatar(me, 44)
            a.fake-input(href="/chat")
              span#greeting(data-name=meName)= t('What do you want to practise today, {name}?', { name: meName })
          .actions
            a(href="/chat")
              +icon('chat', 19)
              = t('Chat')
            a(href="/studio")
              +icon('studio', 19)
              = t('Studio')
            a(href="/community?tab=create")
              +icon('plus', 19)
              = t('Publish')
            a(href="/passages")
              +icon('book', 19)
              = t('Passages')

        - var tabs = [['', t('All'), counts.all], ['vocab', t('Vocab'), counts.vocab], ['listening', t('Listening'), counts.listening], ['writing', t('Writing'), counts.writing]]
        nav.feed-tabs(aria-label=t('Filter the feed'))
          each tb in tabs
            a(href=tb[0] ? `/dashboard?type=${tb[0]}` : '/dashboard' class=type === tb[0] ? 'active' : '')
              = tb[1]
              span= tb[2]

        if feedError
          .error= t(feedError)
        #feed(data-type=type)
          each post in posts
            +feedPost(post)
        if !posts.length && !feedError
          section.feed-empty
            h2= t('No sets here yet')
            p= t('Be the first to share one - make a listening drill in Studio or publish a set.')
            a.btn(href="/community?tab=create")
              +icon('plus', 17)
              = t('Publish a set')
        if hasMore
          button#load-more(type="button" data-offset=nextOffset data-type=type)= t('Load more')

      //- ---- right: progress, trending, creators ----
      aside.rail.rail-right
        .widget
          h3
            = t('Your progress')
            a(href="/progress")= t('See all')
          if progress
            .stats3
              div
                .v.flame= progress.streakDays || 0
                .k= t('day streak')
              div
                .v= progress.xp || 0
                .k XP
              div
                .v= progress.level || 1
                .k= t('Level')
            - var goal = Number(progress.dailyGoal) || 0, done = Number(progress.dailyGoalProgress) || 0
            .goal
              .row
                span= t('Daily goal')
                span= goal > 0 ? `${done} / ${goal}` : t('No daily goal set')
              .bar(role="meter" aria-label=t('Daily goal progress') aria-valuemin="0" aria-valuemax=goal aria-valuenow=done)
                div(style=`width:${goal > 0 ? Math.min(100, done / goal * 100) : 0}%`)
          else
            p.hint= t('Progress is unavailable right now.')
        if trending.length
          .widget
            h3
              = t('Trending sets')
              +icon('trend', 18)
            ol.rank
              each c, i in trending
                li
                  a(href=`/community/${encodeURIComponent(c.id)}`)
                    span.n= i + 1
                    span.t
                      b= c.name
                      small= c.downloads === 1 ? t('{type} · {n} download', { type: t(c.type), n: 1 }) : t('{type} · {n} downloads', { type: t(c.type), n: c.downloads })
        if creators.length
          .widget
            h3
              = t('Top creators')
              +icon('trophy', 18)
            ul.rank
              each c in creators
                li
                  a(href=`/community?q=${encodeURIComponent(c.author)}`)
                    +avatar(c.author, 34)
                    span.t
                      b= c.author
                      small= t(c.sets === 1 ? '1 set' : '{n} sets', { n: c.sets }) + ' · ' + t(c.downloads === 1 ? '1 download' : '{d} downloads', { d: c.downloads })

    #toast.toast(hidden role="status" aria-live="polite")

    script.
      (function () {
        // Time-of-day greeting in the composer.
        var g = document.getElementById('greeting');
        var h = new Date().getHours();
        var key = h < 5 ? 'Good evening' : h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
        g.textContent = t('{greeting}, {name} - what do you want to practise today?', { greeting: t(key), name: g.dataset.name });

        var toast = document.getElementById('toast'), toastTimer = null;
        function say(text) {
          toast.textContent = text;
          toast.hidden = false;
          clearTimeout(toastTimer);
          toastTimer = setTimeout(function () { toast.hidden = true; }, 2200);
        }

        // One shared player for every ▶ in the feed.
        var player = new Audio(), playingBtn = null;
        player.addEventListener('ended', function () { if (playingBtn) playingBtn.classList.remove('playing'); playingBtn = null; });
        document.addEventListener('click', function (e) {
          var play = e.target.closest('.post-items .play');
          if (play) {
            if (playingBtn === play && !player.paused) { player.pause(); play.classList.remove('playing'); playingBtn = null; return; }
            if (playingBtn) playingBtn.classList.remove('playing');
            player.src = play.dataset.src;
            player.play().catch(function () { say(t('Could not play this clip.')); });
            play.classList.add('playing');
            playingBtn = play;
            return;
          }
          var share = e.target.closest('.share');
          if (share) {
            var url = location.origin + share.dataset.url;
            var copied = function () { say(t('Link copied')); };
            if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(url).then(copied, function () { window.prompt(t('Copy this link'), url); });
            else window.prompt(t('Copy this link'), url);
          }
        });

        // Load more: append the next page of posts (server-rendered fragment).
        var more = document.getElementById('load-more');
        if (more) more.addEventListener('click', function () {
          more.disabled = true;
          more.textContent = t('Loading…');
          var qs = 'offset=' + encodeURIComponent(more.dataset.offset) + (more.dataset.type ? '&type=' + encodeURIComponent(more.dataset.type) : '');
          fetch('/feed?' + qs).then(function (res) {
            if (res.redirected) { location.href = '/login?next=/dashboard'; return null; }
            if (!res.ok) throw new Error('HTTP ' + res.status);
            var hasMore = res.headers.get('X-Has-More') === '1';
            var next = res.headers.get('X-Next-Offset');
            return res.text().then(function (html) {
              document.getElementById('feed').insertAdjacentHTML('beforeend', html);
              if (hasMore) { more.dataset.offset = next; more.disabled = false; more.textContent = t('Load more'); }
              else more.remove();
            });
          }).catch(function () { more.disabled = false; more.textContent = t('Load more'); say(t('Could not load more posts.')); });
        });
      })();
