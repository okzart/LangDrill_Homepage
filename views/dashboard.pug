doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title LanguageDrill — Dashboard
    include _style
  body
    include _nav
    h1 Welcome, #{currentUser.email}

    .cards
      section
        h2 Profile
        p View your account details.
        a.btn(href="/profile") Open
      section
        h2 Progress
        p Your XP, streak, weekly activity and accuracy at a glance.
        a.btn(href="/progress") Open
      section
        h2 Community
        p Browse, publish, download, and unpublish shared drill sets.
        a.btn(href="/community") Open
      section
        h2 Chat
        p Practice with the self-hosted AI language tutor.
        a.btn(href="/chat") Open
      section
        h2 Passages
        p Turn your expressions into a short story, then listen and read along.
        a.btn(href="/passages") Open
      section
        h2 Studio
        p Upload audio or video (or record yourself), then crop sentences into listening drills.
        a.btn(href="/studio") Open
      if currentUser.role === 'admin'
        section
          h2 Admin
          p Manage user accounts and their progress records.
          a.btn(href="/admin/users") Open
